---
import { site } from '../site'
import themes from '../data/omarchy-themes.json'
interface Props { title?: string; description?: string; home?: boolean }
const { title, description, home = false } = Astro.props
const pageTitle = title ? `${title} — ${site.name}` : site.name
const cssv = import.meta.env.CSSV || Date.now().toString(36)
const links = [
  { href: '/writing/', label: 'writing' },
  { href: '/projects/', label: 'projects' },
  { href: '/about/', label: 'about' },
  { href: site.github, label: 'github' },
  ...(site.x ? [{ href: site.x, label: 'x' }] : []),
]
const fonts = [
  { value: 'jetbrains-mono', label: 'jetbrains mono', family: 'JetBrains Mono' },
  { value: 'adwaita-mono', label: 'adwaita mono', family: 'Adwaita Mono' },
  { value: 'ia-writer-mono-s', label: 'ia writer mono s', family: 'iA Writer Mono S' },
  { value: 'liberation-mono', label: 'liberation mono', family: 'Liberation Mono' },
  { value: 'nimbus-mono-ps', label: 'nimbus mono ps', family: 'Nimbus Mono PS' },
]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      // Before first paint: apply settings saved in cookies.
      ;(() => {
        const cookies = Object.fromEntries(document.cookie.split('; ').map(c => c.split('=')))
        const root = document.documentElement
        if (cookies.site_theme && cookies.site_theme !== 'auto') root.dataset.theme = cookies.site_theme
        if (cookies.site_mode && cookies.site_mode !== 'auto') root.dataset.mode = cookies.site_mode
        if (cookies.site_font && cookies.site_font !== 'jetbrains-mono') root.dataset.font = cookies.site_font
      })()
    </script>
    <link rel="stylesheet" href={`/styles.css?v=${cssv}`} />
    <link rel="stylesheet" href={`/themes.css?v=${cssv}`} />
    <link rel="icon" href={site.avatar} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
  </head>
  <body>
    <div class="settings">
      <button class="settings-btn" id="settings-btn" aria-label="Appearance" aria-expanded="false">◐</button>
      <div class="settings-panel" id="settings-panel" hidden>
        <p class="settings-label">mode</p>
        <div class="segmented" data-setting="mode">
          <button type="button" data-value="auto">auto</button>
          <button type="button" data-value="light">light</button>
          <button type="button" data-value="dark">dark</button>
        </div>
        <p class="settings-label">font</p>
        <div class="choice-list" data-setting="font">
          {fonts.map(f => (
            <button type="button" data-value={f.value} style={`font-family: '${f.family}', monospace`}>{f.label}</button>
          ))}
        </div>
        <p class="settings-label">theme <span class="settings-hint">(omarchy)</span></p>
        <div class="choice-list themes" data-setting="theme">
          <button type="button" data-value="auto">
            <span class="swatch swatch-auto"></span>default
          </button>
          {themes.map(t => (
            <button type="button" data-value={t.name}>
              <span class="swatch" style={`background:${t.bg}`}><span style={`background:${t.accent}`}></span></span>{t.name}
            </button>
          ))}
        </div>
      </div>
    </div>
    <div class="page">
      {!home && (
        <nav class="topnav">
          <a class="undecorated" href="/">{site.name.toLowerCase()}</a>
          <span class="sep">{' — '}</span>
          {links.map((l, i) => (
            <>
              {i > 0 && <span class="sep">{' / '}</span>}
              <a href={l.href}>{l.label}</a>
            </>
          ))}
        </nav>
      )}
      <main>
        <slot />
      </main>
      <footer class="footer">
        <a href="/rss.xml">rss</a> · static files · since 2026
      </footer>
    </div>
    <script>
      const root = document.documentElement
      const defaults: Record<string, string> = { theme: 'auto', font: 'jetbrains-mono', mode: 'auto' }
      const cookies = Object.fromEntries(document.cookie.split('; ').map(c => c.split('=')))

      const btn = document.getElementById('settings-btn')!
      const panel = document.getElementById('settings-panel')!
      const setOpen = (open: boolean) => {
        panel.hidden = !open
        btn.setAttribute('aria-expanded', String(open))
      }
      btn.addEventListener('click', () => setOpen(panel.hidden))
      document.addEventListener('click', e => {
        if (!panel.hidden && !(e.target as Element).closest('.settings')) setOpen(false)
      })
      document.addEventListener('keydown', e => { if (e.key === 'Escape') setOpen(false) })

      for (const group of document.querySelectorAll<HTMLElement>('[data-setting]')) {
        const key = group.dataset.setting!
        const buttons = group.querySelectorAll<HTMLButtonElement>('button[data-value]')
        const mark = (v: string) => buttons.forEach(b => b.classList.toggle('on', b.dataset.value === v))
        mark(cookies[`site_${key}`] || defaults[key])
        buttons.forEach(b => b.addEventListener('click', () => {
          const v = b.dataset.value!
          document.cookie = `site_${key}=${v};max-age=31536000;path=/;samesite=lax`
          if (v === defaults[key]) delete root.dataset[key]
          else root.dataset[key] = v
          mark(v)
        }))
      }
    </script>
  </body>
</html>

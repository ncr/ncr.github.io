---
import { site } from '../site'
import themes from '../data/omarchy-themes.json'
interface Props { title?: string; description?: string; home?: boolean }
const { title, description, home = false } = Astro.props
const pageTitle = title ? `${title} — ${site.name}` : site.name
const links = [
  { href: '/writing/', label: 'writing' },
  { href: '/projects/', label: 'projects' },
  { href: '/about/', label: 'about' },
  { href: site.github, label: 'github' },
  ...(site.x ? [{ href: site.x, label: 'x' }] : []),
]
const fonts = [
  { value: 'jetbrains-mono', label: 'jetbrains mono' },
  { value: 'adwaita-mono', label: 'adwaita mono' },
  { value: 'ia-writer-mono-s', label: 'ia writer mono s' },
  { value: 'liberation-mono', label: 'liberation mono' },
  { value: 'nimbus-mono-ps', label: 'nimbus mono ps' },
]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      // Before first paint: apply settings saved in cookies.
      ;(() => {
        const cookies = Object.fromEntries(document.cookie.split('; ').map(c => c.split('=')))
        const root = document.documentElement
        if (cookies.site_theme && cookies.site_theme !== 'auto') root.dataset.theme = cookies.site_theme
        if (cookies.site_mode && cookies.site_mode !== 'auto') root.dataset.mode = cookies.site_mode
        if (cookies.site_font && cookies.site_font !== 'jetbrains-mono') root.dataset.font = cookies.site_font
      })()
    </script>
    <link rel="stylesheet" href="/styles.css" />
    <link rel="stylesheet" href="/themes.css" />
    <link rel="icon" href={site.avatar} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
  </head>
  <body>
    <div class="page">
      {!home && (
        <nav class="topnav">
          <a class="undecorated" href="/">{site.name.toLowerCase()}</a>
          <span class="sep">{' — '}</span>
          {links.map((l, i) => (
            <>
              {i > 0 && <span class="sep">{' / '}</span>}
              <a href={l.href}>{l.label}</a>
            </>
          ))}
        </nav>
      )}
      <main>
        <slot />
      </main>
      <footer class="footer">
        <a href="/rss.xml">rss</a>
        <span>·</span>
        <label for="pick-theme">theme:</label>
        <select id="pick-theme" class="theme-picker" data-setting="theme" aria-label="Theme">
          <option value="auto">default</option>
          <optgroup label="omarchy">
            {themes.map(t => <option value={t.name}>{t.name}</option>)}
          </optgroup>
        </select>
        <label for="pick-font">font:</label>
        <select id="pick-font" class="theme-picker" data-setting="font" aria-label="Font">
          {fonts.map(f => <option value={f.value}>{f.label}</option>)}
        </select>
        <label for="pick-mode">mode:</label>
        <select id="pick-mode" class="theme-picker" data-setting="mode" aria-label="Light or dark mode">
          <option value="auto">auto</option>
          <option value="light">light</option>
          <option value="dark">dark</option>
        </select>
        <span>·</span>
        <span>since 2026</span>
      </footer>
    </div>
    <script>
      const root = document.documentElement
      const defaults: Record<string, string> = { theme: 'auto', font: 'jetbrains-mono', mode: 'auto' }
      const cookies = Object.fromEntries(document.cookie.split('; ').map(c => c.split('=')))
      for (const el of document.querySelectorAll<HTMLSelectElement>('select[data-setting]')) {
        const key = el.dataset.setting!
        el.value = cookies[`site_${key}`] || defaults[key]
        el.addEventListener('change', () => {
          const v = el.value
          document.cookie = `site_${key}=${v};max-age=31536000;path=/;samesite=lax`
          if (v === defaults[key]) delete root.dataset[key]
          else root.dataset[key] = v
        })
      }
    </script>
  </body>
</html>

---
import { site } from '../site'
import ThemeDots from '../components/ThemeDots.astro'
interface Props { title?: string; description?: string; home?: boolean }
const { title, description, home = false } = Astro.props
const pageTitle = title ? `${title} — ${site.name}` : site.name
const cssv = import.meta.env.CSSV || Date.now().toString(36)
const Name = home ? 'h1' : 'p'
const links = [
  { href: '/writing/', label: 'writing' },
  { href: '/projects/', label: 'projects' },
  { href: '/about/', label: 'about' },
  { href: site.github, label: 'github' },
  ...(site.x ? [{ href: site.x, label: 'x' }] : []),
]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      // Before first paint: apply the theme saved in the cookie.
      ;(() => {
        const m = document.cookie.match(/(?:^|; )site_theme=([^;]+)/)
        if (m && m[1] !== 'auto') document.documentElement.dataset.theme = m[1]
      })()
    </script>
    <link rel="stylesheet" href={`/styles.css?v=${cssv}`} />
    <link rel="stylesheet" href={`/themes.css?v=${cssv}`} />
    <link rel="icon" href={site.avatar} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
  </head>
  <body>
    <div class="page">
      <header class="masthead">
        <div class="who">
          <a class="undecorated who-link" href="/">
            <img class="avatar" src={site.avatar} alt="" width="48" height="48" />
            <Name class="name">{site.name}</Name>
          </a>
          <ThemeDots />
        </div>
        {home && <p class="intro">{site.intro}</p>}
        <nav class="nav">
          {links.map((l, i) => (
            <>
              {i > 0 && <span class="sep">{' / '}</span>}
              <a href={l.href}>{l.label}</a>
            </>
          ))}
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="footer">
        <a href="/rss.xml">rss</a> · since 2026
      </footer>
    </div>
    <script>
      const root = document.documentElement
      const dock = document.querySelector('.theme-line')!
      const buttons = dock.querySelectorAll<HTMLButtonElement>('button[data-value]')
      const mark = (v: string) => buttons.forEach(b => b.classList.toggle('on', b.dataset.value === v))
      const saved = document.cookie.match(/(?:^|; )site_theme=([^;]+)/)
      mark(saved ? saved[1] : 'auto')
      buttons.forEach(b => b.addEventListener('click', () => {
        const v = b.dataset.value!
        document.cookie = `site_theme=${v};max-age=31536000;path=/;samesite=lax`
        if (v === 'auto') delete root.dataset.theme
        else root.dataset.theme = v
        mark(v)
      }))
    </script>
  </body>
</html>

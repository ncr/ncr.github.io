---
import { site } from '../site'
import ThemePicker from '../components/ThemePicker.astro'
interface Props { title?: string; description?: string; home?: boolean; lang?: string; robots?: string; image?: string }
const { title, description, home = false, lang = "en", robots, image } = Astro.props
// a page with an image gets a link card (Open Graph, X); URLs absolute from the site's address
const canonical = new URL(Astro.url.pathname, Astro.site).href
const card = image && new URL(image, Astro.site).href
const pageTitle = title ? `${title} — ${site.name}` : site.name
const cssv = import.meta.env.CSSV || Date.now().toString(36)
const Name = home ? 'h1' : 'p'
const path = Astro.url.pathname
const links = [
  { href: '/writing/', label: 'writing' },
  { href: '/projects/', label: 'projects' },
  { href: '/about/', label: 'about' },
  { href: site.github, label: 'github' },
  ...(site.x ? [{ href: site.x, label: 'x' }] : []),
]
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {robots && <meta name="robots" content={robots} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {card && <>
      <link rel="canonical" href={canonical} />
      <meta property="og:type" content="article" />
      <meta property="og:site_name" content={site.name} />
      <meta property="og:title" content={title} />
      {description && <meta property="og:description" content={description} />}
      <meta property="og:url" content={canonical} />
      <meta property="og:image" content={card} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      {description && <meta name="twitter:description" content={description} />}
      <meta name="twitter:image" content={card} />
    </>}
    <script is:inline>
      // Before first paint: apply the theme saved in the cookie.
      ;(() => {
        const m = document.cookie.match(/(?:^|; )site_theme=([^;]+)/)
        if (m && m[1] !== 'auto' && m[1] !== 'p-bloom') document.documentElement.dataset.theme = m[1]
      })()
    </script>
    <meta name="theme-color" content="#090d16" />
    <link rel="stylesheet" href={`/styles.css?v=${cssv}`} />
    <link rel="stylesheet" href={`/themes.css?v=${cssv}`} />
    <link rel="icon" href={site.avatar} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
  </head>
  <body>
    <div class="page">
      <header class="masthead">
        <div class="who">
          <a class="undecorated who-link" href="/">
            <img class="avatar" src={site.avatar} alt="" width="36" height="36" />
            <Name class="name">{site.name}</Name>
          </a>
        </div>
        <nav class="nav" aria-label="Site">
          {links.map(l => (
            <a href={l.href} aria-current={path.startsWith(l.href) || (l.href === '/writing/' && path.startsWith('/blog/')) ? 'page' : undefined}>{l.label}</a>
          ))}
        </nav>
        <div class="tools">
          <slot name="header-tools" />
          <ThemePicker />
        </div>
        <slot name="header-player" />
      </header>
      {home && <p class="intro">{site.intro}</p>}
      <main>
        <slot />
      </main>
      <footer class="footer">
        <span>{site.name}</span>
        <span><a href="/rss.xml">rss</a> · since 2026</span>
      </footer>
    </div>
    <script>
      const root = document.documentElement
      // No cookie (or the old value 'auto') = the default, p(bloom).
      const DEFAULT = 'p-bloom'
      const picker = document.querySelector('.theme-picker')!
      const toggle = picker.querySelector<HTMLButtonElement>('.theme-toggle')!
      const menu = picker.querySelector<HTMLElement>('.theme-menu')!
      const buttons = [...menu.querySelectorAll<HTMLButtonElement>('button[data-value]')]
      const current = () => {
        const m = document.cookie.match(/(?:^|; )site_theme=([^;]+)/)
        return m && m[1] !== 'auto' ? m[1] : DEFAULT
      }
      const mark = (v: string) => buttons.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.value === v)))
      mark(current())
      // Images with data-light/data-dark follow the active theme's color-scheme.
      const themeImages = () => {
        const dark = getComputedStyle(root).colorScheme.includes('dark')
        document.querySelectorAll<HTMLImageElement>('img[data-light]').forEach(img => {
          const src = dark ? img.dataset.dark! : img.dataset.light!
          if (img.getAttribute('src') !== src) img.src = src
        })
      }
      themeImages()
      // In auto, follow live system switches too.
      matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { themeImages(); themeColor() })
      // Browser chrome (mobile address bar) follows the page background.
      const themeColor = () => document.querySelectorAll('meta[name="theme-color"]').forEach(m => m.setAttribute('content', getComputedStyle(document.body).backgroundColor))
      themeColor()
      const apply = (v: string) => {
        if (v === DEFAULT) {
          document.cookie = 'site_theme=;max-age=0;path=/;samesite=lax'
          delete root.dataset.theme
        } else {
          document.cookie = `site_theme=${v};max-age=31536000;path=/;samesite=lax`
          root.dataset.theme = v
        }
        mark(v)
        themeImages()
        themeColor()
      }
      const open = (yes: boolean, focus = true) => {
        menu.hidden = !yes
        toggle.setAttribute('aria-expanded', String(yes))
        if (yes && focus) (buttons.find(b => b.getAttribute('aria-pressed') === 'true') || buttons[0]).focus()
        else if (!yes && focus) toggle.focus()
      }
      toggle.addEventListener('click', () => open(menu.hidden))
      buttons.forEach(b => b.addEventListener('click', () => apply(b.dataset.value!)))
      // Keyboard: arrows move through the palettes (two columns), Esc closes.
      menu.addEventListener('keydown', e => {
        const i = buttons.indexOf(document.activeElement as HTMLButtonElement)
        if (e.key === 'Escape') { e.preventDefault(); open(false) }
        else if (e.key === 'Home' || e.key === 'End') { e.preventDefault(); buttons[e.key === 'Home' ? 0 : buttons.length - 1].focus() }
        else if (i >= 0 && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')) {
          e.preventDefault()
          buttons[Math.min(buttons.length - 1, Math.max(0, i + (e.key === 'ArrowRight' ? 1 : -1)))].focus()
        } else if (i >= 0 && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
          // Nearest button in the next row down/up, by position (rows differ in width).
          e.preventDefault()
          const r = buttons[i].getBoundingClientRect(), down = e.key === 'ArrowDown'
          const rows = buttons.map(b => b.getBoundingClientRect()).map((q, j) => ({ j, q }))
            .filter(({ q }) => down ? q.top >= r.bottom - 1 : q.bottom <= r.top + 1)
          if (rows.length) {
            const edge = down ? Math.min(...rows.map(x => x.q.top)) : Math.max(...rows.map(x => x.q.top))
            const row = rows.filter(x => Math.abs(x.q.top - edge) < 2)
            row.sort((a, b) => Math.abs(a.q.left - r.left) - Math.abs(b.q.left - r.left))
            buttons[row[0].j].focus()
          }
        }
      })
      document.addEventListener('click', e => { if (!menu.hidden && !picker.contains(e.target as Node)) open(false, false) })
      picker.addEventListener('focusout', e => { if (!menu.hidden && !picker.contains(e.relatedTarget as Node | null) && e.relatedTarget) open(false, false) })
    </script>
  </body>
</html>

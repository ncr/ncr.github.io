---
import { site } from '../site'
import themes from '../data/omarchy-themes.json'
interface Props { title?: string; description?: string; home?: boolean }
const { title, description, home = false } = Astro.props
const pageTitle = title ? `${title} — ${site.name}` : site.name
const links = [
  { href: '/writing/', label: 'writing' },
  { href: '/projects/', label: 'projects' },
  { href: '/about/', label: 'about' },
  { href: site.github, label: 'github' },
  ...(site.x ? [{ href: site.x, label: 'x' }] : []),
]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      // Before first paint: apply the saved theme, if any.
      const saved = localStorage.getItem('theme')
      if (saved && saved !== 'auto') document.documentElement.dataset.theme = saved
    </script>
    <link rel="stylesheet" href="/styles.css" />
    <link rel="stylesheet" href="/themes.css" />
    <link rel="icon" href={site.avatar} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
  </head>
  <body>
    <div class="page">
      {!home && (
        <nav class="topnav">
          <a class="undecorated" href="/">{site.name.toLowerCase()}</a>
          <span class="sep">{' — '}</span>
          {links.map((l, i) => (
            <>
              {i > 0 && <span class="sep">{' / '}</span>}
              <a href={l.href}>{l.label}</a>
            </>
          ))}
        </nav>
      )}
      <main>
        <slot />
      </main>
      <footer class="footer">
        <a href="/rss.xml">rss</a>
        <span>·</span>
        <label for="theme">theme:</label>
        <select id="theme" class="theme-picker" aria-label="Theme">
          <option value="auto">auto</option>
          <option value="light">light</option>
          <option value="dark">dark</option>
          <optgroup label="omarchy">
            {themes.map(t => <option value={t.name}>{t.name}</option>)}
          </optgroup>
        </select>
        <span>·</span>
        <span>since 2026</span>
      </footer>
    </div>
    <script>
      const picker = document.getElementById('theme') as HTMLSelectElement
      picker.value = localStorage.getItem('theme') || 'auto'
      picker.addEventListener('change', () => {
        const v = picker.value
        localStorage.setItem('theme', v)
        if (v === 'auto') delete document.documentElement.dataset.theme
        else document.documentElement.dataset.theme = v
      })
    </script>
  </body>
</html>

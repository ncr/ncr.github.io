---
// Strona właściciela: wklejenie klucza prywatnego (JWK z peer/tools/keygen.mjs) do tej
// przeglądarki. Potem pod komentarzami pojawiają się reakcje autora i „ukryj".
import Base from '../../layouts/Base.astro'
---
<Base title="Owner key">
  <section class="me">
    <h1>Owner key</h1>
    <p class="status">…</p>
    <form class="load">
      <textarea name="jwk" placeholder='{"crv":"Ed25519", …}' rows="4"></textarea>
      <div class="actions">
        <button class="send">Load into this browser</button>
        <button type="button" class="clear link">remove key from this browser</button>
      </div>
    </form>
    <p class="hint">The key is imported as a non-extractable CryptoKey in this browser's IndexedDB –
      the page script can sign with it but cannot read it. Keep the JWK file out of the repo.</p>
  </section>
</Base>
<script>
  import { getOwnerKey, setOwnerKey, clearOwnerKey } from '../../lib/identity'
  import { OWNER_PUBKEY } from '../../lib/config'
  import { shortIdent } from '../../lib/ident'
  const root = document.querySelector<HTMLElement>('.me')!
  const status = root.querySelector<HTMLElement>('.status')!
  const form = root.querySelector<HTMLFormElement>('form')!
  const ta = form.querySelector<HTMLTextAreaElement>('textarea')!
  async function show() {
    const k = await getOwnerKey()
    if (!k) { status.textContent = 'no owner key in this browser'; return }
    status.textContent = `loaded key #${shortIdent(k.pubkey).id}`
      + (k.pubkey === OWNER_PUBKEY ? " – matches the site's owner key" : ' – WARNING: the site was built with a different PUBLIC_OWNER_PUBKEY, readers will reject your reactions and moderation')
  }
  form.addEventListener('submit', async e => {
    e.preventDefault()
    try { await setOwnerKey(JSON.parse(ta.value)); ta.value = ''; await show() }
    catch (err) { status.textContent = `failed: ${(err as Error).message}` }
  })
  root.querySelector('.clear')!.addEventListener('click', async () => { await clearOwnerKey(); await show() })
  show()
</script>

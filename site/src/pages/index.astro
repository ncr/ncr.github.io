---
import Base from '../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { site } from '../site'
import { homeSchema } from '../agents'
const posts = (await getCollection('blog', p => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5)
// Names and status tags as on /projects/ (anchors match the ids there).
const projects = [
  { id: 'trixbrix', name: 'Trixbrix', status: 'active' },
  { id: 'automat', name: 'Automat', status: 'active' },
  { id: 'omaphones', name: 'Omaphones', status: 'active' },
  { id: 'rack-proxy', name: 'rack-proxy', status: 'old, maintained' },
]
import { readingLabel } from '../reading'
const fmt = (d: Date) => d.toISOString().slice(0, 10)
---
<Base home description={site.intro} schema={homeSchema(Astro.site!.origin)}>
  <p class="section-label">latest</p>
  <ul class="postlist entries">
    {posts.map(p => (
      <li>
        <span class="date">{fmt(p.data.date)} · {readingLabel(p.body)}</span>
        <a class="title" href={`/blog/${p.id}/`}>{p.data.title}</a>
        {p.data.description && <p class="desc">{p.data.description}</p>}
      </li>
    ))}
  </ul>

  <p class="section-label"><a class="undecorated" href="/projects/">projects</a></p>
  <ul class="teaser">
    {projects.map(p => (
      <li><a href={`/projects/#${p.id}`}>{p.name}</a><span class={`status ${p.status === 'active' ? 'active' : ''}`}>{p.status}</span></li>
    ))}
  </ul>
</Base>

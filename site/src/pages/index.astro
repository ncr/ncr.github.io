---
import Base from '../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { site } from '../site'
import { excerpt } from '../lib/excerpt'
const posts = (await getCollection('blog', p => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
---
<Base>
  <Fragment slot="bio">
    <div class="bio" set:html={site.bio} />
    <hr class="rule" />
  </Fragment>
  {posts.map(p => (
    <article class="card">
      <header>
        <div class="date">{fmt(p.data.date)}</div>
        <h2><a class="undecorated" href={`/blog/${p.id}/`}>{p.data.title}</a></h2>
      </header>
      <div class="content">{p.data.description || excerpt(p.body || '')}</div>
      <a class="btn" href={`/blog/${p.id}/`}>Read more</a>
    </article>
  ))}
</Base>

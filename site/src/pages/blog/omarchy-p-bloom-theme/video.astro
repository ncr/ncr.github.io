---
// The music video on its own: a link that plays in place where it is shared (Discord and others read og:video),
// with the cover as its poster, and the same player as in the post.
import Base from '../../../layouts/Base.astro'
import PBloomPost from '../../../components/PBloomPost.astro'
import { getEntry } from 'astro:content'
const post = await getEntry('blog', 'omarchy-p-bloom-theme')
if (!post) throw new Error('Expected the p(bloom) post')
---
<Base title="Prepare to Walk" description="The p(bloom) music video, in electronic and rock. A theme for Omarchy with 42 wallpapers of machines from a future worth building."
  image="/blog-assets/p-bloom-video-poster.jpg" imageSize={[1280, 720]} video="/gallery/destiny/video/prepare-to-walk-av-1080p60.mp4">
  <PBloomPost post={post} videoOnly />
</Base>

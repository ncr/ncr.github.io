---
// Profil komentującego: /u/?k=<klucz publiczny>. Strona statyczna, komentarze zbiera skrypt
// z replik peera wszystkich wpisów (lista z /posts.json).
import Base from '../../layouts/Base.astro'
---
<Base title="Komentarze">
  <section class="profile">
    <header>
      <span class="badge big"></span>
      <h1><span class="nick">…</span> <span class="myid"></span></h1>
      <p class="sub"></p>
    </header>
    <div class="list"></div>
  </section>
</Base>
<script>
  import { mountProfile } from '../../lib/profile'
  mountProfile(document.querySelector<HTMLElement>('.profile')!)
</script>

---
import Base from '../../layouts/Base.astro'
import { getEntry, render } from 'astro:content'
// Explicit opt-in for this one draft; other drafts keep their existing visibility.
const post = await getEntry('blog', 'omarchy-destiny-theme')
if (!post || !post.data.draft) throw new Error('Expected the Destiny draft')
const { Content } = await render(post)
---
<Base title={post.data.title} description={post.data.description} lang="pl" robots="noindex, nofollow, noarchive">
  <article class="post">
    <header>
      <p class="date">DRAFT · 25 września 2026 · podgląd dostępny przez link</p>
      <h1>{post.data.title}</h1>
    </header>
    <div class="content"><Content /></div>
  </article>
</Base>

<style is:global>
  .detail-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; width: min(1240px, calc(100vw - 40px)); position: relative; left: 50%; transform: translateX(-50%); margin: 2rem 0; }
  .detail-pair .figure { margin: 0; min-width: 0; }
  .detail-pair .figure > p { margin: 0 0 12px; }
  .detail-pair img { width: 100%; }
  .detail-triptych { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 800px) { .detail-pair { grid-template-columns: 1fr; width: 100%; gap: 28px; } }
</style>

---
// The music video, inline: a still cover with a play button, then controls laid over the picture — play/pause,
// a bar, the time, the take (electronic or rock, keeps the position), the quality (Auto, SD, HD, 4K), wide (the whole
// browser width) and fullscreen.
// The controls hide while playing when the pointer rests, and come back on any movement.
const video = '/gallery/destiny/video/'
---
<figure class="mvi" aria-label="Prepare to Walk, the p(bloom) music video">
  <div class="mvi-frame">
    <video class="mvi-video is-on" data-take="electronic" playsinline preload="none" poster={`${video}prepare-to-walk-poster.webp?v=5`} aria-label="Prepare to Walk, the p(bloom) music video (electronic): the theme and its 42 wallpapers"></video>
    <video class="mvi-video" data-take="rock" playsinline muted preload="none" poster={`${video}prepare-to-walk-rock-poster.webp?v=5`} aria-label="Prepare to Walk, the p(bloom) music video (rock)" aria-hidden="true"></video>
    <button type="button" class="mvi-badge" aria-label="Play the music video"><svg viewBox="0 0 40 40" width="46" height="46" aria-hidden="true"><path d="M15.2 9.5 32 20 15.2 30.5z" fill="currentColor" stroke="currentColor" stroke-width="3.5" stroke-linejoin="round"/></svg></button>
    <div class="mvi-bar">
      <button type="button" class="mvi-btn mvi-play" aria-label="Play"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="i-play" d="M8.6 5.5v13l10.5-6.5z"/><path class="i-pause" d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg></button>
      <input class="mvi-seek" type="range" min="0" max="119.88" step="0.01" value="0" aria-label="Video position" />
      <span class="mvi-time">0:00</span>
      <div class="mvi-take" role="group" aria-label="Version of the song">
        <button type="button" data-take="electronic" aria-pressed="true">Electronic</button><button type="button" data-take="rock" aria-pressed="false">Rock</button>
      </div>
      <div class="mvi-take mvi-quality" role="group" aria-label="Quality">
        <button type="button" data-q="auto" aria-pressed="true" title="Automatic: by the size of the player">Auto</button><button type="button" data-q="0" aria-pressed="false" title="720p">SD</button><button type="button" data-q="1" aria-pressed="false" title="1080p">HD</button><button type="button" data-q="2" aria-pressed="false" title="2160p">4K</button>
      </div>
      <button type="button" class="mvi-btn mvi-wide" aria-pressed="false" aria-label="Wide: the whole browser width" title="Wide (W)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18v10H3z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M7 12h10M7 12l2.5-2.5M7 12l2.5 2.5M17 12l-2.5-2.5M17 12l-2.5 2.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
      <button type="button" class="mvi-btn mvi-back" aria-label="Back to the article's player" title="Back to the player"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M11 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button type="button" class="mvi-btn mvi-full" aria-label="Fullscreen" title="Fullscreen (F)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
  </div>
  <noscript><p><a href={`${video}prepare-to-walk-av-1080p60.mp4`}>Music video (MP4)</a> · <a href={`${video}prepare-to-walk-rock-av-1080p60.mp4`}>rock version</a></p></noscript>
</figure>
<script define:vars={{ video }}>
  (() => {
    // Two takes, two videos. Once playback starts both play together: the chosen one visible and audible, the other
    // hidden and muted, kept on the same time. Switching swaps visibility and sound only, so it is instant.
    const root = document.querySelector('.mvi'), frame = root.querySelector('.mvi-frame');
    const V = Object.fromEntries([...root.querySelectorAll('.mvi-video')].map(x => [x.dataset.take, x]));
    const badge = root.querySelector('.mvi-badge'), play = root.querySelector('.mvi-play'), seek = root.querySelector('.mvi-seek'), time = root.querySelector('.mvi-time');
    const wide = root.querySelector('.mvi-wide'), full = root.querySelector('.mvi-full'), takes = [...root.querySelectorAll('.mvi-take:not(.mvi-quality) button')];
    let seeking = false, raf = 0, take = 'electronic', idle = 0, sync = 0;
    const cur = () => V[take], other = () => V[take === 'rock' ? 'electronic' : 'rock'];
    // three sizes, by the pixels the frame shows (its width, or the screen's in fullscreen, times the pixel ratio):
    // 720p and 1080p from this site, 4K from media.jacekbecela.com (AV1 where the browser plays it, else H.264);
    // a bigger frame (wide, fullscreen, a resize) moves up a size at the same moment, never down
    const av1 = document.createElement('video').canPlayType('video/mp4; codecs="av01.0.12M.10"') === 'probably';
    const need = () => Math.max(frame.getBoundingClientRect().width, document.fullscreenElement ? screen.width : 0) * devicePixelRatio;
    const pick = () => navigator.connection?.saveData ? 0 : need() > 2200 ? 2 : need() > 1200 ? 1 : 0;
    // the quality switch: Auto (the size above, moving up as the frame grows) or a fixed size, up or down
    const qs = [...root.querySelectorAll('.mvi-quality button')];
    let quality = 'auto';
    try { const q = localStorage.getItem('pbloom-quality'); if (['auto', '0', '1', '2'].includes(q)) quality = q; } catch {}
    let tier = -1;
    const file = t => tier === 2
      ? `https://media.jacekbecela.com/prepare-to-walk-${t === 'rock' ? 'rock-v10' : 'electronic-v30'}-${av1 ? 'av1-' : ''}2160p60.mp4`
      : `${video}prepare-to-walk${t === 'rock' ? '-rock' : ''}-av-${tier ? '1080' : '720'}p60.mp4?v=5`;
    const wanted = () => quality === 'auto' ? pick() : Number(quality);
    const shown = () => { for (const b of qs) { b.setAttribute('aria-pressed', String(b.dataset.q === quality)); b.classList.toggle('is-auto', quality === 'auto' && b.dataset.q === String(tier < 0 ? pick() : tier)); } };
    const src = () => { if (tier < 0) { tier = wanted(); shown(); } for (const [t, x] of Object.entries(V)) if (!x.getAttribute('src')) { x.preload = 'auto'; x.src = file(t); } };
    const swap = n => {
      tier = n; shown();
      for (const [t, x] of Object.entries(V)) {
        if (!x.getAttribute('src')) continue;
        const at = x.currentTime, was = !x.paused;
        x.addEventListener('loadedmetadata', () => { x.currentTime = at; if (was) x.play().catch(() => {}); }, { once: true });
        x.src = file(t);
      }
    };
    const upgrade = () => { if (tier >= 0 && quality === 'auto' && pick() > tier) swap(pick()); };
    for (const b of qs) b.addEventListener('click', () => {
      quality = b.dataset.q;
      try { localStorage.setItem('pbloom-quality', quality); } catch {}
      if (tier < 0) shown(); else if (wanted() !== tier) swap(wanted()); else shown();
    });
    shown();
    const fmt = s => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    const tick = () => { const v = cur(); if (!seeking) seek.value = String(v.currentTime); time.textContent = fmt(v.currentTime); seek.style.setProperty('--p', `${(v.currentTime / (Number(seek.max) || 1)) * 100}%`); raf = v.paused ? 0 : requestAnimationFrame(tick); };
    const state = e => { if (e && e.target !== cur()) return; const v = cur(), p = v.paused; play.setAttribute('aria-label', p ? 'Play' : 'Pause'); root.classList.toggle('is-playing', !p); root.classList.toggle('has-started', v.currentTime > 0 || !p); cancelAnimationFrame(raf); tick(); wake(); };
    // the hidden take follows the chosen one: same play state, time kept within ~40 ms by nudging its rate (no seeks)
    const follow2 = () => {
      const a = cur(), b = other(); if (!b.getAttribute('src')) return;
      if (a.paused || a.ended) { if (!b.paused) b.pause(); if (Math.abs(b.currentTime - a.currentTime) > .05 && a.currentTime < (b.duration || 1e9)) b.currentTime = a.currentTime; b.playbackRate = 1; return; }
      if (a.currentTime >= (b.duration || 1e9) - .05) return;
      const d = a.currentTime - b.currentTime;
      if (Math.abs(d) > .6) { b.currentTime = a.currentTime; b.playbackRate = 1; }
      else b.playbackRate = Math.abs(d) < .04 ? 1 : 1 + Math.max(-.12, Math.min(.12, d * .8));
      if (b.paused) b.play().catch(() => {});
    };
    const toggle = () => { src(); const v = cur(); if (v.paused) v.play().catch(() => {}); else v.pause(); };
    // controls: visible while paused or when the pointer moves, hidden after 2.5 s of rest while playing
    // the bar hides after 2.5 s at rest, but never while the pointer is over it — checked against the last known
    // pointer position, because a resize (wide) moves the bar under a still pointer without any pointer event
    const bar = root.querySelector('.mvi-bar'); let onBar = false, px = -1, py = -1;
    addEventListener('pointermove', e => { px = e.clientX; py = e.clientY; }, { passive: true });
    const overBar = () => { const r = bar.getBoundingClientRect(); return px >= r.left && px <= r.right && py >= r.top && py <= r.bottom; };
    const wake = () => { root.classList.remove('is-idle'); clearTimeout(idle); if (!cur().paused && !onBar) idle = setTimeout(() => { if (overBar()) wake(); else root.classList.add('is-idle'); }, 2500); };
    bar.addEventListener('pointerenter', () => { onBar = true; wake(); }); bar.addEventListener('pointerleave', () => { onBar = false; wake(); });
    for (const x of Object.values(V)) {
      for (const e of ['play', 'pause', 'ended', 'seeked', 'loadedmetadata']) x.addEventListener(e, ev => { state(ev); if (ev.target === cur()) follow2(); });
      x.addEventListener('loadedmetadata', () => { if (x === cur() && isFinite(x.duration)) seek.max = String(x.duration); });
      x.onclick = toggle;
    }
    setInterval(() => { if (!cur().paused) follow2(); }, 250);
    badge.onclick = toggle; play.onclick = toggle;
    frame.addEventListener('pointermove', wake); frame.addEventListener('pointerdown', wake); frame.addEventListener('focusin', wake);
    seek.addEventListener('input', () => { seeking = true; src(); const t = Number(seek.value); for (const x of Object.values(V)) x.currentTime = Math.min(t, (x.duration || 1e9) - .05); time.textContent = fmt(t); seek.style.setProperty('--p', `${(t / (Number(seek.max) || 1)) * 100}%`); });
    seek.addEventListener('change', () => { seeking = false; }); seek.addEventListener('pointerup', () => { seeking = false; });
    takes.forEach(b => b.onclick = () => {
      if (b.dataset.take === take) return;
      const a = cur(), playing = !a.paused, at = a.currentTime;
      take = b.dataset.take; takes.forEach(x => x.setAttribute('aria-pressed', String(x === b)));
      const n = cur();
      if (Math.abs(n.currentTime - at) > .15 && n.getAttribute('src')) n.currentTime = Math.min(at, (n.duration || 1e9) - .05);
      n.muted = false; a.muted = true; n.playbackRate = 1;
      n.classList.add('is-on'); a.classList.remove('is-on'); n.removeAttribute('aria-hidden'); a.setAttribute('aria-hidden', 'true');
      if (playing && n.paused) n.play().catch(() => {});
      if (isFinite(n.duration)) seek.max = String(n.duration);
      state(); follow2();
      try { localStorage.setItem('pbloom-take', take); } catch {}
    });
    // the last chosen take is remembered in this browser
    try { const saved = localStorage.getItem('pbloom-take'); if (saved === 'rock') takes.find(x => x.dataset.take === 'rock')?.click(); } catch {}
    // wide: the player breaks out of the text column to nearly the whole browser width, with a margin on both sides
    // (never taller than the window)
    // the width animates between two pixel values (the column and the wide size), so the height follows smoothly
    // docked: while the film has started and its place in the article is off screen, the player sits in the right-hand
    // margin, sized to that margin (never over the text column); it goes back when its place scrolls into view
    const GAP = 20, dockW = () => { const col = root.parentElement.getBoundingClientRect(); return Math.min(480, innerWidth - col.right - 2 * GAP); };
    let inView = true;
    const dock = () => {
      const w = dockW(), on = !inView && root.classList.contains('has-started') && !document.fullscreenElement && w >= 220;
      if (on === root.classList.contains('is-docked')) { if (on) root.style.setProperty('--dock-w', `${w}px`); return; }
      if (on) { root.style.minHeight = `${frame.getBoundingClientRect().height}px`; root.style.setProperty('--dock-w', `${w}px`); root.classList.add('is-docked'); }
      else { root.classList.remove('is-docked'); root.style.minHeight = ''; }
      wake();
    };
    new IntersectionObserver(([e]) => { inView = e.isIntersecting; dock(); }, { threshold: 0 }).observe(root);
    addEventListener('resize', dock);
    for (const x of Object.values(V)) x.addEventListener('play', dock);
    root.querySelector('.mvi-back').onclick = () => root.scrollIntoView({ block: 'center', behavior: 'smooth' });

    // wide: a 16:9 frame, centred (left = right, top = bottom), as large as the window allows with at least 40 px
    // of margin on the tighter pair of sides
    // the resting size comes from the CSS (the breakout); measured with the inline sizes lifted for a moment
    const baseW = () => { const w = root.style.width, m = root.style.marginLeft; root.style.width = root.style.marginLeft = ''; const b = root.getBoundingClientRect().width; root.style.width = w; root.style.marginLeft = m; return b; };
    const wideBox = () => { const w = Math.max(baseW(), Math.min(innerWidth - 80, (innerHeight - 80) * 16 / 9)); return { w, h: w * 9 / 16 }; };
    const size = (w, h) => { const col = root.parentElement.getBoundingClientRect().width; root.style.width = `${w}px`; root.style.marginLeft = `${(col - w) / 2}px`; frame.style.height = `${h}px`; };
    let sizing = 0;
    const setWide = on => {
      const r0 = frame.getBoundingClientRect();
      root.classList.add('is-sizing'); clearTimeout(sizing);
      root.style.transition = frame.style.transition = 'none';
      const to = on ? wideBox() : (b => ({ w: b, h: b * 9 / 16 }))(baseW());
      root.classList.toggle('is-wide', on); wide.setAttribute('aria-pressed', String(on));
      size(r0.width, r0.height); root.getBoundingClientRect();
      root.style.transition = frame.style.transition = ''; size(to.w, to.h);
      // one smooth scroll to where the player will end up (computed from its final size), started with the resize:
      // going wide, its centre lands in the middle of the window; going back, its centre stays where it is on screen.
      // (Scrolling frame by frame during the resize left Chromium painting a stale picture until the next scroll.)
      const top = r0.top + scrollY, c0 = r0.top + r0.height / 2;
      window.scrollTo({ top: Math.max(0, on ? top + to.h / 2 - innerHeight / 2 : top + to.h / 2 - c0), behavior: 'smooth' });
      sizing = setTimeout(() => {
        root.classList.remove('is-sizing');
        if (!root.classList.contains('is-wide')) { root.style.width = ''; root.style.marginLeft = ''; frame.style.height = ''; }
        // a 1 px scroll there and back makes every browser refresh hit-testing after the resize
        const y = scrollY; window.scrollTo({ top: y + 1, behavior: 'instant' }); window.scrollTo({ top: y, behavior: 'instant' });
        upgrade();                                         // wide on a big screen: the next size up
      }, 700);
      wake(); setTimeout(wake, 700);
    };
    addEventListener('resize', () => { requestAnimationFrame(upgrade); if (root.classList.contains('is-wide')) { const b = wideBox(); root.style.transition = frame.style.transition = 'none'; size(b.w, b.h); requestAnimationFrame(() => { root.style.transition = frame.style.transition = ''; }); } });
    // from fullscreen, "wide" leaves fullscreen and lands in wide mode
    const wideClick = async () => {
      if (document.fullscreenElement) { await document.exitFullscreen().catch(() => {}); await new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r))); if (!root.classList.contains('is-wide')) setWide(true); return; }
      setWide(!root.classList.contains('is-wide'));
    };
    wide.onclick = wideClick;
    // fullscreen: the frame with its controls
    const setFull = () => { (document.fullscreenElement ? document.exitFullscreen() : (frame.requestFullscreen || frame.webkitRequestFullscreen)?.call(frame))?.catch?.(() => {}); };
    full.onclick = setFull; Object.values(V).forEach(x => x.ondblclick = setFull);
    if (!document.fullscreenEnabled && !frame.webkitRequestFullscreen) full.hidden = true;
    document.addEventListener('fullscreenchange', () => { requestAnimationFrame(upgrade); const f = document.fullscreenElement === frame; root.classList.toggle('is-full', f); wide.setAttribute('aria-pressed', String(!f && root.classList.contains('is-wide'))); });
    frame.addEventListener('keydown', e => {
      if (e.target.matches('input')) return;
      if (e.code === 'Space' && !e.target.matches('button')) { e.preventDefault(); toggle(); }
      else if (e.key.toLowerCase() === 'f') { e.preventDefault(); setFull(); }
      else if (e.key.toLowerCase() === 'w') { e.preventDefault(); wideClick(); }
      else if (e.key === 'Escape' && root.classList.contains('is-wide')) setWide(false);
    });
  })();
</script>
<style>
  .mvi { --w: max(min(100%, 100cqw), min(var(--pb-wide, 100%), 100cqw, calc((100svh - 24rem) * 16 / 9))); width: var(--w); margin: 1.4rem 0 2.6rem calc((100% - var(--w)) / 2); }
  /* only the wide toggle animates; a window resize follows at once */
  .mvi.is-sizing { transition: width .55s cubic-bezier(.3,.7,.2,1), margin-left .55s cubic-bezier(.3,.7,.2,1); }
  .mvi.is-sizing .mvi-frame { transition: height .55s cubic-bezier(.3,.7,.2,1); }
  @media (prefers-reduced-motion: reduce) { .mvi.is-sizing, .mvi.is-sizing .mvi-frame { transition: none; } }
  .mvi-frame { position: relative; aspect-ratio: 16 / 9; border-radius: 10px; overflow: hidden; border: 1px solid var(--hairline); background: #04060b; }
  .mvi-frame:fullscreen { border: 0; border-radius: 0; aspect-ratio: auto; width: 100vw; height: 100vh; }
  .mvi-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; cursor: pointer; display: block; opacity: 0; pointer-events: none; }
  .mvi-video.is-on { opacity: 1; pointer-events: auto; }
  .mvi-frame:fullscreen .mvi-video { object-fit: contain; }
  .mvi-badge { position: absolute; left: 50%; top: 50%; width: 84px; height: 84px; margin: -42px 0 0 -42px; display: grid; place-items: center; padding: 0; border-radius: 50%; background: #070a11b3; border: 1.5px solid #ffffffd0; color: #fff; cursor: pointer; backdrop-filter: blur(6px); transition: transform .15s ease, opacity .2s ease; z-index: 2; }
  .mvi-badge:hover { transform: scale(1.06); }
  .mvi.has-started .mvi-badge { opacity: 0; pointer-events: none; }
  /* the controls sit on the picture, over a soft gradient; hidden until the video has started */
  .mvi-bar { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; display: flex; align-items: center; gap: 10px; padding: 34px 14px 12px; background: linear-gradient(transparent, #04060bd9 70%); color: #eef4ff; opacity: 0; transform: translateY(6px); pointer-events: none; transition: opacity .25s ease, transform .25s ease; }
  .mvi.has-started .mvi-bar { opacity: 1; transform: none; pointer-events: auto; }
  .mvi.has-started.is-idle .mvi-bar { opacity: 0; transform: translateY(6px); }
  .mvi.is-idle .mvi-video { cursor: none; }
  .mvi-btn { width: 34px; height: 34px; flex: none; display: grid; place-items: center; padding: 0; border: 0; border-radius: 50%; background: none; color: inherit; cursor: pointer; }
  .mvi-btn svg { width: 20px; height: 20px; fill: currentColor; }
  .mvi-btn:hover, .mvi-btn[aria-pressed="true"] { background: #ffffff1f; }
  .mvi-play .i-pause, .mvi.is-playing .mvi-play .i-play { display: none; } .mvi.is-playing .mvi-play .i-pause { display: inline; }
  .mvi-seek { --p: 0%; flex: 1; min-width: 60px; height: 18px; margin: 0; -webkit-appearance: none; appearance: none; background: transparent; cursor: pointer; }
  .mvi-seek::-webkit-slider-runnable-track { height: 3px; border-radius: 3px; background: linear-gradient(to right, #4cc9ff var(--p), #ffffff40 var(--p)); }
  .mvi-seek::-moz-range-track { height: 3px; border-radius: 3px; background: #ffffff40; } .mvi-seek::-moz-range-progress { height: 3px; border-radius: 3px; background: #4cc9ff; }
  .mvi-seek::-webkit-slider-thumb { -webkit-appearance: none; width: 12px; height: 12px; margin-top: -4.5px; border-radius: 50%; background: #fff; border: 0; }
  .mvi-seek::-moz-range-thumb { width: 12px; height: 12px; border-radius: 50%; background: #fff; border: 0; }
  .mvi-time { font-family: var(--mono); font-size: .7rem; letter-spacing: .04em; color: #c9d6ea; min-width: 2.6rem; text-align: right; font-variant-numeric: tabular-nums; }
  .mvi-take { display: flex; flex: none; border: 1px solid #ffffff35; border-radius: 999px; padding: 2px; }
  .mvi-take button { font-family: var(--mono); font-size: .62rem; letter-spacing: .1em; text-transform: uppercase; padding: 5px 9px; border: 0; border-radius: 999px; background: none; color: #c9d6ea; cursor: pointer; }
  .mvi-take button[aria-pressed="true"] { background: #ffffff2b; color: #fff; }
  .mvi-take button:hover { color: #4cc9ff; }
  .mvi-quality button.is-auto { box-shadow: inset 0 0 0 1px #ffffff40; }   /* the size Auto is playing */
  .mvi-back { display: none; }
  /* docked in the right-hand margin while scrolling */
  .mvi.is-docked .mvi-frame { position: fixed; right: 20px; bottom: 20px; z-index: 30; width: var(--dock-w) !important; height: calc(var(--dock-w) * 9 / 16) !important; aspect-ratio: auto; border-radius: 8px; box-shadow: 0 14px 40px #000a; animation: mvi-dock .35s cubic-bezier(.2,.75,.2,1); }
  .mvi.is-docked .mvi-video { object-fit: cover; }
  .mvi.is-docked .mvi-bar { gap: 4px; padding: 22px 6px 4px; }
  .mvi.is-docked .mvi-time, .mvi.is-docked .mvi-take, .mvi.is-docked .mvi-wide, .mvi.is-docked .mvi-full { display: none; }
  .mvi.is-docked .mvi-back { display: grid; }
  @keyframes mvi-dock { from { opacity: 0; transform: translateY(16px) scale(.96); } }
  @media (prefers-reduced-motion: reduce) { .mvi.is-docked .mvi-frame { animation: none; } }
  @media (max-width: 560px) { .mvi-bar { gap: 4px; padding: 26px 8px 8px; } .mvi-time { display: none; } .mvi-wide { display: none; } .mvi-quality { display: none; } .mvi-take button { padding: 4px 7px; font-size: .56rem; } }
</style>

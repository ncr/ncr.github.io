---
// Pasek statystyk w stopce każdej strony: online teraz, online w czasie (24 h), wizyty.
import T from './T.astro'
---
<div class="stats" aria-live="polite">
  <div class="stat online">
    <span class="label">Online</span>
    <span class="value-row"><span class="dot"></span><span class="value">–</span></span>
  </div>
  <div class="stat chart-wrap">
    <span class="label"><T pl="Ostatnie 24 h" en="Last 24 h" /> <span class="max"></span></span>
    <svg class="chart" width="200" height="28" role="img"></svg>
  </div>
  <div class="stat visits">
    <span class="label"><T pl="Wizyty" en="Visits" /></span>
    <span class="value-row"><span class="here">–</span><span class="sep"><T pl="tu" en="here" /></span><span class="total">–</span><span class="sep"><T pl="łącznie" en="total" /></span></span>
  </div>
</div>
<script>
  import { mountStats } from '../lib/stats'
  document.querySelectorAll<HTMLElement>('.stats').forEach(mountStats)
</script>

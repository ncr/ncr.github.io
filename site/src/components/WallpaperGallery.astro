---
import gallery from '../data/destiny-gallery.json'
const wallpapers = gallery
const cover = wallpapers.find(w => w.id === 'o01') || wallpapers[0]
const video = '/gallery/destiny/video/'
const clipDuration = 119.88
---
<section class="wallpaper-entry" aria-label="42 wallpapers">
  <p class="wall-label">42 wallpapers</p>
  <div class="wall-thumbs">
    {wallpapers.map((w, i) => <button type="button" data-open={i} aria-label={`${i + 1}. ${w.name}`}><img src={w.thumb} alt="" width="1600" height="900" loading="lazy" /></button>)}
  </div>
  <noscript><p><a href="https://github.com/ncr/omarchy-p-bloom-theme/tree/main/backgrounds">All wallpapers</a></p></noscript>
</section>
<dialog id="wallpaper-viewer" aria-label="42 wallpapers" data-cover={wallpapers.indexOf(cover)}>
  <div class="gallery-shell">
    <header class="viewer-top">
      <div class="viewer-label" aria-live="polite" aria-atomic="true"><span class="viewer-count"></span><h2 class="viewer-title"></h2></div>
      <button type="button" class="viewer-close icon-button" aria-label="Close" title="Close (Esc)">✕</button>
    </header>
    <div class="viewer-canvas" tabindex="0" aria-label="Wallpaper. Arrow keys change the image, Z toggles zoom.">
      <div class="viewer-frame"><img class="viewer-preview" alt="" /><img class="viewer-image" alt="" /></div>
    </div>
    <p class="viewer-error" role="status" hidden>Could not load the full image. <button type="button" class="viewer-retry">Try again</button></p>
    <button type="button" class="viewer-prev edge-nav icon-button" aria-label="Previous wallpaper" title="Previous (←)"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <button type="button" class="viewer-next edge-nav icon-button" aria-label="Next wallpaper" title="Next (→)"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    <footer class="viewer-bottom">
      <button type="button" class="viewer-grid-toggle" aria-expanded="false" aria-controls="viewer-grid"><svg class="vb-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"/></svg><span>All wallpapers</span><span class="gallery-total">42</span></button>
      <div class="viewer-tools">
        <button type="button" class="viewer-zoom" aria-pressed="false" title="Zoom (Z)"><svg class="vb-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13zM15.5 15.5 20 20M10.5 7.5v6M7.5 10.5h6"/></svg><span>Detail</span></button>
        <a class="viewer-download" aria-label="Download wallpaper" download title="Download the 5120 × 2880 original"><svg class="vb-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11M7.5 10.5 12 15l4.5-4.5M5 19.5h14"/></svg><span>Download</span></a>
      </div>
    </footer>
    <section id="viewer-grid" aria-label="Choose a wallpaper" hidden>
      <div class="grid-heading"><p>Choose a wallpaper · 42 images</p><button type="button" class="grid-close icon-button" aria-label="Back to viewing" title="Back to viewing">✕</button></div>
      <div class="wallpaper-grid">
        {wallpapers.map((w, i) => <button type="button" data-index={i} aria-label={`${i + 1}. ${w.name}`}><img src={w.thumb} alt="" width="5120" height="2880" loading="lazy" /><span>{w.name}</span></button>)}
      </div>
    </section>
  </div>
</dialog>
<script define:vars={{ wallpapers, video }}>
  (() => {
    const dialog = document.querySelector('#wallpaper-viewer');
    const q = s => dialog.querySelector(s);
    const opens = document.querySelectorAll('.wall-thumbs [data-open]'); let opener = null;
    const canvas = q('.viewer-canvas'), frame = q('.viewer-frame');
    const photo = q('.viewer-image'), preview = q('.viewer-preview');
    const grid = q('#viewer-grid'), gridToggle = q('.viewer-grid-toggle');
    const zoomButton = q('.viewer-zoom');
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let index = Number(dialog.dataset.cover), zoom = false, previousOverflow = '', touchStart = null, drag = null, request = 0, ownsFullscreen = false;
    let watching = false, effects = true, seeking = false, tick = 0;

    // Free browsing tells the ambient ink loops when they may run.
    function ambient(){}
    function setZoom(value) {
      zoom = value; canvas.classList.toggle('is-zoomed', zoom);
      if (zoom) { const cw = canvas.clientWidth, ch = canvas.clientHeight, ar = (photo.naturalWidth / photo.naturalHeight) || 16 / 9, w = Math.min(cw, ch * ar), h = w / ar, k = Math.max(2.4, cw / w, ch / h); frame.style.width = `${w * k}px`; frame.style.height = `${h * k}px`; }
      else { frame.style.width = ''; frame.style.height = ''; }
      zoomButton.setAttribute('aria-pressed', String(zoom));
      zoomButton.innerHTML = zoom ? '<svg class="vb-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13zM15.5 15.5 20 20M7.5 10.5h6"/></svg><span>Whole</span>' : '<svg class="vb-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 4a6.5 6.5 0 1 1 0 13 6.5 6.5 0 0 1 0-13zM15.5 15.5 20 20M10.5 7.5v6M7.5 10.5h6"/></svg><span>Detail</span>';
      requestAnimationFrame(() => { canvas.scrollLeft = zoom ? (canvas.scrollWidth - canvas.clientWidth) / 2 : 0; canvas.scrollTop = zoom ? (canvas.scrollHeight - canvas.clientHeight) / 2 : 0; });
    }
    function setGrid(value) {
      if(value) leaveVideo();
      grid.hidden = !value; gridToggle.setAttribute('aria-expanded', String(value));
      dialog.classList.toggle('grid-open', value);
      if(value) { const selected = grid.querySelector(`[data-index="${index}"]`); selected.focus(); selected.scrollIntoView({block:'nearest'}); }
      else canvas.focus({preventScroll:true});
    }
    function show(next) {
      leaveVideo();
      index = (next + wallpapers.length) % wallpapers.length;
      const w = wallpapers[index], ticket = ++request;
      setZoom(false); q('.viewer-error').hidden = true;
      q('.viewer-count').textContent = `${String(index+1).padStart(2,'0')} / ${wallpapers.length}`;
      q('.viewer-title').textContent = w.name;
      q('.viewer-download').href = w.src;
      preview.style.visibility = 'visible'; preview.src = w.thumb; photo.style.visibility = 'hidden'; photo.alt = w.name;
      const image = new Image(); image.src = w.src;
      image.decode().then(async () => { if(ticket!==request) return; photo.src = w.src; try { await photo.decode(); } catch {} if(ticket!==request) return; photo.style.visibility = 'visible'; preview.style.visibility = 'hidden'; }).catch(() => { if(ticket===request) q('.viewer-error').hidden = false; });
      grid.querySelectorAll('[data-index]').forEach(b => b.setAttribute('aria-current', String(Number(b.dataset.index)===index)));
      ambient();
    }

    function leaveVideo() {}

    // ── Dialog ──
    // the picture's place in the viewer (contained in the canvas)
    function target() { const c = canvas.getBoundingClientRect(), ar = 16 / 9, w = Math.min(c.width, c.height * ar), h = w / ar; return { left: c.left + (c.width - w) / 2, top: c.top + (c.height - h) / 2, width: w, height: h }; }
    // a copy of the thumbnail flies between the page and the viewer while the viewer's chrome fades
    async function fly(src, from, to, dur) {
      const img = document.createElement('img'); img.src = src; img.className = 'viewer-fly'; // styled inline: the component's scoped CSS doesn't reach elements made here
      Object.assign(img.style, { position: 'fixed', zIndex: '10', margin: '0', objectFit: 'cover', transformOrigin: '0 0', borderRadius: '0', pointerEvents: 'none', left: `${to.left}px`, top: `${to.top}px`, width: `${to.width}px`, height: `${to.height}px` });
      dialog.append(img); await img.decode().catch(() => {});
      const t = r => `translate(${r.left - to.left}px, ${r.top - to.top}px) scale(${r.width / to.width}, ${r.height / to.height})`;
      return img.animate([{ transform: t(from) }, { transform: 'none' }], { duration: dur, easing: 'cubic-bezier(.2,.75,.2,1)' }).finished.then(() => img).catch(() => img);
    }
    const still = () => reduced.matches;
    const chrome = () => dialog.querySelectorAll('.viewer-top, .viewer-bottom, .edge-nav');
    opens.forEach(b => b.addEventListener('click', async () => {
      opener = b; previousOverflow = document.body.style.overflow; document.body.style.overflow = 'hidden';
      const from = b.querySelector('img').getBoundingClientRect();
      dialog.showModal(); show(Number(b.dataset.open)); canvas.focus({preventScroll:true});
      if (still()) return;
      frame.style.opacity = '0';
      dialog.animate([{ backgroundColor: 'rgba(7,9,14,0)' }, { backgroundColor: 'rgba(7,9,14,1)' }], { duration: 380, easing: 'ease-out' });
      chrome().forEach(e => e.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 380, delay: 120, easing: 'ease-out', fill: 'backwards' }));
      const img = await fly(b.querySelector('img').currentSrc || b.querySelector('img').src, from, target(), 440);
      frame.style.opacity = ''; img.remove();
    }));
    const pointerMode = on => { dialog.toggleAttribute('data-pointer', on); document.querySelector('.wallpaper-entry')?.toggleAttribute('data-pointer', on); };
    for (const el of [dialog, document.querySelector('.wallpaper-entry')]) { el?.addEventListener('pointerdown', () => pointerMode(true)); el?.addEventListener('keydown', e => { if (e.key === 'Tab') pointerMode(false); }); }
    let closing = false;
    async function close() {
      if (closing) return;
      const thumb = document.querySelector(`.wall-thumbs [data-open="${index}"] img`);
      if (thumb && !still() && !zoom && grid.hidden) {
        thumb.scrollIntoView({ block: 'nearest' });
        const to = thumb.getBoundingClientRect();
        if (to.bottom > 0 && to.top < innerHeight) {
          closing = true; frame.style.opacity = '0';
          chrome().forEach(e => e.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 200, fill: 'forwards' }));
          dialog.animate([{ backgroundColor: 'rgba(7,9,14,1)' }, { backgroundColor: 'rgba(7,9,14,0)' }], { duration: 380, easing: 'ease-in', fill: 'forwards' });
          const from = target(), img = document.createElement('img'); img.src = thumb.currentSrc || thumb.src; img.className = 'viewer-fly'; // styled inline: the component's scoped CSS doesn't reach elements made here
          Object.assign(img.style, { position: 'fixed', zIndex: '10', margin: '0', objectFit: 'cover', transformOrigin: '0 0', borderRadius: '0', pointerEvents: 'none', left: `${to.left}px`, top: `${to.top}px`, width: `${to.width}px`, height: `${to.height}px` }); dialog.append(img); await img.decode().catch(() => {});
          const t = r => `translate(${r.left - to.left}px, ${r.top - to.top}px) scale(${r.width / to.width}, ${r.height / to.height})`;
          await img.animate([{ transform: t(from) }, { transform: 'none' }], { duration: 380, easing: 'cubic-bezier(.4,0,.2,1)' }).finished.catch(() => {});
          img.remove(); dialog.getAnimations().forEach(a => a.cancel()); dialog.querySelectorAll('*').forEach(e => e.getAnimations().forEach(a => a.cancel()));
          frame.style.opacity = ''; closing = false;
        }
      }
      dialog.close();
    }
    dialog.addEventListener('close', () => { document.body.style.overflow = previousOverflow; const t = document.querySelector(`.wall-thumbs [data-open="${index}"]`) || opener; t?.focus({preventScroll:true, focusVisible:false}); t?.scrollIntoView({block:'nearest'}); });
    dialog.addEventListener('cancel', e => { e.preventDefault(); if(!grid.hidden) setGrid(false); else if(zoom) setZoom(false); else close(); });
    q('.viewer-close').onclick = close;
    q('.viewer-prev').onclick = () => show(index-1); q('.viewer-next').onclick = () => show(index+1);
    q('.viewer-retry').onclick = () => show(index);
    gridToggle.onclick = () => setGrid(grid.hidden); q('.grid-close').onclick = () => setGrid(false);
    grid.querySelectorAll('[data-index]').forEach(b => b.onclick = () => { show(Number(b.dataset.index)); setGrid(false); });
    zoomButton.onclick = () => setZoom(!zoom);
    dialog.addEventListener('keydown', e => {
      if(!grid.hidden || (e.target.matches('input') && e.key !== ' ')) return;
      if(e.key === 'ArrowRight' || e.key === 'ArrowLeft') { e.preventDefault(); show(index + (e.key === 'ArrowRight' ? 1 : -1)); }
      if(e.key.toLowerCase() === 'z') { e.preventDefault(); setZoom(!zoom); }
      if(e.key === 'Home') { e.preventDefault(); show(0); } if(e.key === 'End') { e.preventDefault(); show(wallpapers.length-1); }
    });
    canvas.addEventListener('dblclick', () => { if(!watching) setZoom(!zoom); });
    canvas.addEventListener('touchstart', e => { if(e.touches.length===1 && !zoom && !watching) touchStart = {x:e.touches[0].clientX, y:e.touches[0].clientY}; else touchStart = null; }, {passive:true});
    canvas.addEventListener('touchend', e => { if(!touchStart || zoom) return; const dx = e.changedTouches[0].clientX - touchStart.x, dy = e.changedTouches[0].clientY - touchStart.y; if(Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)*1.4) show(index + (dx < 0 ? 1 : -1)); touchStart = null; }, {passive:true});
    canvas.addEventListener('pointerdown', e => { if(zoom && e.pointerType === 'mouse') { drag = {x:e.clientX, y:e.clientY, left:canvas.scrollLeft, top:canvas.scrollTop}; canvas.setPointerCapture(e.pointerId); e.preventDefault(); } });
    canvas.addEventListener('pointermove', e => { if(drag) { canvas.scrollLeft = drag.left + drag.x - e.clientX; canvas.scrollTop = drag.top + drag.y - e.clientY; } });
    canvas.addEventListener('pointerup', () => drag = null); canvas.addEventListener('pointercancel', () => drag = null);
    frame.addEventListener('dragstart', e => e.preventDefault());

  })();
</script>
<style>
#wallpaper-viewer .viewer-grid-toggle{display:flex;align-items:center;gap:8px;background:#d7e8f7;color:#101722;font-weight:550;border:1px solid #eaf4ff}.gallery-total{font-size:11px;background:#13263d15;padding:2px 6px;border-radius:6px;font-variant-numeric:tabular-nums}.viewer-bottom{border-top:1px solid #ffffff0b}.viewer-top{border-bottom:1px solid #ffffff0b}.viewer-tools{align-items:center}.viewer-bottom .tour-return{border:1px solid #ffffff25!important}
.wallpaper-entry{margin:1.6rem 0 2.6rem}.play-badge{position:absolute;left:50%;top:50%;width:84px;height:84px;margin:-42px 0 0 -42px;display:grid;place-items:center;border-radius:50%;background:#070a11b3;border:1.5px solid #ffffffd0;color:#fff;backdrop-filter:blur(6px);box-shadow:0 8px 30px #0008;transition:transform .2s ease,background .2s ease;z-index:1}.play-badge svg{display:block}.gallery-launch:hover .play-badge,.gallery-launch:focus-visible .play-badge{transform:scale(1.08);background:#4cc9ffd9;border-color:#4cc9ff}@media(max-width:700px){.play-badge{width:64px;height:64px;margin:-32px 0 0 -32px}.play-badge svg{width:38px;height:38px}}.gallery-launch{position:relative;display:block;width:100%;padding:0;overflow:hidden;border:1px solid #ffffff20;border-radius:16px;background:#090d16;color:white;cursor:pointer;text-align:left;box-shadow:0 14px 40px #00000013}.gallery-launch>img{display:block;width:100%;height:auto;min-height:220px;object-fit:cover;transition:transform .65s ease}.gallery-launch:hover>img{transform:scale(1.035)}.gallery-invite{position:absolute;inset:auto 0 0;display:flex;align-items:end;justify-content:space-between;padding:45px 22px 20px;background:linear-gradient(transparent,#070a11e8);font-family:system-ui,sans-serif}.gallery-invite strong{display:block;font-size:20px;font-weight:500}.gallery-invite small{display:block;color:#bdc7d9;font-size:13px;margin-top:4px}.entry-arrow{border:1px solid #ffffff45;border-radius:50%;width:40px;height:40px;display:grid;place-items:center;font-size:24px}
#wallpaper-viewer{position:fixed;inset:0;margin:0;width:100%;height:100%;height:100dvh;max-width:none;max-height:none;padding:0;border:0;background:#07090e;color:#eff3fa;font-family:system-ui,sans-serif;color-scheme:dark}#wallpaper-viewer::backdrop{background:#07090e}.gallery-shell{height:100%;position:relative;display:grid;grid-template-rows:auto minmax(0,1fr) auto}button,a{ -webkit-tap-highlight-color:transparent}#wallpaper-viewer button,#wallpaper-viewer a{font:inherit;color:inherit}#wallpaper-viewer button{cursor:pointer;border:1px solid transparent;background:transparent}#wallpaper-viewer button:hover,#wallpaper-viewer a:hover{background:#ffffff12}#wallpaper-viewer :focus-visible,.gallery-launch:focus-visible{outline:2px solid #97caff;outline-offset:-3px}#wallpaper-viewer [hidden]{display:none!important}.viewer-top{display:flex;align-items:center;justify-content:space-between;padding: max(14px,env(safe-area-inset-top)) 24px 12px;z-index:2}.viewer-label{display:flex;align-items:center;gap:18px;min-width:0}.viewer-count{font-size:12px;color:#8992a4;letter-spacing:.12em;white-space:nowrap;font-variant-numeric:tabular-nums}.viewer-title{margin:0;font-size:15px;font-weight:450;color:#dce1ed}.icon-button{width:44px;height:44px;border-radius:50%;flex-shrink:0}.viewer-close{font-size:22px!important}.viewer-canvas{overflow:hidden;position:relative;min-height:0;outline:none;touch-action:pan-y}.viewer-frame{width:100%;height:100%;position:relative}.viewer-frame img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;user-select:none}.viewer-image{transition:opacity .18s}.viewer-canvas.is-zoomed{overflow:auto;cursor:grab;touch-action:pan-x pan-y}.viewer-canvas.is-zoomed:active{cursor:grabbing}.is-zoomed .viewer-frame{width:240%;height:240%}.edge-nav{position:absolute;top:50%;transform:translateY(-50%);z-index:2;font-size:40px!important;background:#080b12a8!important;border:1px solid #ffffff18!important;backdrop-filter:blur(16px)}.viewer-prev{left:16px}.viewer-next{right:16px}.viewer-bottom{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:14px 24px max(14px,env(safe-area-inset-bottom));z-index:2;color:#b4bdce;font-size:13px}.viewer-bottom button,.viewer-bottom a{min-height:44px;padding:10px 14px;border-radius:24px;text-decoration:none;white-space:nowrap}.viewer-tools{display:flex;gap:4px}.viewer-bottom [aria-pressed=true]{background:#ffffff18!important;color:white!important}.viewer-error{position:absolute;bottom:80px;left:50%;transform:translateX(-50%);padding:10px 18px;background:#151a25;border-radius:12px;font-size:13px;z-index:3}.viewer-retry{text-decoration:underline}
#viewer-grid{position:absolute;inset:70px 0 0;background:#0b0e15f8;z-index:4;overflow:auto;padding:12px max(24px,calc((100vw - 1400px)/2)) 32px;backdrop-filter:blur(20px)}.grid-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-bottom:18px;color:#aab3c4;font-size:14px}.grid-heading p{margin:0}.wallpaper-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:20px 16px}.wallpaper-grid button{padding:5px!important;text-align:left;border-radius:10px}.wallpaper-grid img{display:block;width:100%;height:auto;border-radius:6px;aspect-ratio:16/9;object-fit:cover}.wallpaper-grid span{display:block;font-size:12px;margin:8px 4px;color:#acb5c6}.wallpaper-grid [aria-current=true]{border-color:#8eacd5!important;background:#ffffff08!important}.grid-open .edge-nav{display:none}
@media(prefers-reduced-motion:reduce){.gallery-launch>img,.viewer-image{transition:none}}
#wallpaper-viewer .viewer-grid-toggle:hover{background:#eef7ff;color:#101722}
.viewer-error{top:82px;bottom:auto;max-width:440px;background:#151a25ed;box-shadow:0 6px 20px #0004}
.gallery-launch.is-previewing .gallery-invite strong{font-size:15px}
.gallery-launch.is-previewing .gallery-invite{padding-top:25px;background:linear-gradient(transparent,#070a11bd)}
@media(max-width:700px){.viewer-top{padding-left:14px;padding-right:10px}.viewer-label{gap:10px}.viewer-title{font-size:13px}.viewer-count{font-size:11px}.viewer-bottom{padding-left:8px;padding-right:8px;font-size:12px;gap:0}.viewer-bottom button,.viewer-bottom a{padding:10px}.viewer-fullscreen span,.viewer-download span{display:inline}.viewer-prev{left:6px}.viewer-next{right:6px}.edge-nav{top:auto;bottom:80px;transform:none}.wallpaper-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 10px}#viewer-grid{padding:10px 12px 24px}.gallery-launch>img{min-height:240px}.gallery-invite{padding:40px 18px 18px}.viewer-error{width:90%;text-align:center}}
@media(max-width:700px){.viewer-bottom{flex-wrap:wrap;gap:6px;padding:10px 12px!important}.viewer-bottom button,.viewer-bottom a{font-size:11px!important;padding:8px!important}.viewer-tools{gap:0!important}.viewer-bottom .tour-return{order:3;width:100%}.viewer-grid-toggle{gap:5px!important}.gallery-total{font-size:10px!important}}
.tour-return{white-space:nowrap}
.mv-video{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;background:#04060b;display:none;z-index:3;cursor:pointer}
.is-touring .mv-video{display:block}
.is-touring .viewer-frame,.is-touring .edge-nav,.is-touring .viewer-zoom,.is-touring .viewer-fx,.is-touring .viewer-download{display:none!important}
.is-touring .gallery-shell{grid-template-rows:auto minmax(0,1fr) auto auto}
.mv-player{padding:12px 24px 4px;background:#07090e}
.mv-controls{max-width:1000px;margin:auto;display:flex;align-items:center;gap:14px}
.mv-play{width:44px;height:44px;border-radius:50%;font-size:20px!important;flex-shrink:0;border:1px solid #ffffff25!important}
.mv-seek{flex:1;min-width:0;height:28px;margin:0;accent-color:#90caff;cursor:pointer}
.mv-credit{max-width:1000px;margin:8px auto 0;padding-left:58px;font-size:12px;color:#8f9cb0}
.mv-credit a{color:#c9d8ec;text-decoration:none;border-bottom:1px solid #c9d8ec40}.mv-credit a:hover{border-color:#c9d8ec}
@media(max-width:700px){.mv-player{padding:10px 14px 2px}.mv-controls{gap:10px}.mv-play{width:40px;height:40px}.mv-credit{padding-left:0;font-size:11px}.mv-credit span{display:none}}
.wallpaper-entry{margin:3.4rem 0 1rem}.wall-label{font-family:var(--mono);font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin:0 0 .8rem}
.wall-thumbs{display:grid;grid-template-columns:repeat(6,1fr);gap:6px}.wall-thumbs button{padding:0;border:1px solid var(--hairline);border-radius:5px;overflow:hidden;background:#04060b;cursor:zoom-in;aspect-ratio:16/9}.wall-thumbs img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .2s ease,opacity .2s}.wall-thumbs button:hover img{transform:scale(1.06)}.wall-thumbs button:hover{border-color:var(--link)}
@media(max-width:600px){.wall-thumbs{grid-template-columns:repeat(3,1fr)}}
/* the viewer in the post's type: condensed caps for the title, mono for counts and controls, no light pills */
#wallpaper-viewer{font-family:'Jost',system-ui,sans-serif}
#wallpaper-viewer .viewer-title{font-family:'Archivo Narrow','Arial Narrow',sans-serif;font-weight:700;text-transform:uppercase;letter-spacing:.02em;font-size:18px;color:#eef4ff}
#wallpaper-viewer .viewer-count,#wallpaper-viewer .viewer-bottom,#wallpaper-viewer .grid-heading p{font-family:'iA Writer Mono S',ui-monospace,monospace;text-transform:uppercase;letter-spacing:.1em;font-size:11px}
#wallpaper-viewer .viewer-grid-toggle{background:none;color:#eef4ff;font-weight:400;border:1px solid #ffffff35}
#wallpaper-viewer .viewer-grid-toggle:hover{background:#ffffff14;color:#eef4ff;border-color:#4cc9ff}
#wallpaper-viewer .gallery-total{background:#ffffff1f;color:#eef4ff}
#wallpaper-viewer .wallpaper-grid span{font-family:'Archivo Narrow','Arial Narrow',sans-serif;font-weight:700;text-transform:uppercase;letter-spacing:.02em}
.wall-thumbs button:focus:not(:focus-visible){outline:none}
#wallpaper-viewer .viewer-bottom button,#wallpaper-viewer .viewer-bottom a{text-transform:inherit;letter-spacing:inherit;display:inline-flex;align-items:center;gap:6px;line-height:1}
/* no focus frame around the picture; keyboard focus stays visible on the buttons */
#wallpaper-viewer .viewer-canvas:focus,#wallpaper-viewer .viewer-canvas:focus-visible{outline:none}
.viewer-fly{position:fixed;z-index:10;margin:0;object-fit:cover;transform-origin:0 0;border-radius:4px;pointer-events:none;will-change:transform}
#wallpaper-viewer .edge-nav{display:grid;place-items:center;padding:0;font-size:0!important;color:#eef4ff}
#wallpaper-viewer .edge-nav svg{display:block}
#wallpaper-viewer .edge-nav:hover{border-color:#4cc9ff!important;color:#4cc9ff}
#wallpaper-viewer[data-pointer] :focus,#wallpaper-viewer[data-pointer] :focus-visible,.wallpaper-entry[data-pointer] :focus,.wallpaper-entry[data-pointer] :focus-visible{outline:none!important}
/* one height and one icon size for every control on the bottom bar */
#wallpaper-viewer .viewer-bottom button,#wallpaper-viewer .viewer-bottom a{height:38px;min-height:0;padding:0 14px;gap:8px;line-height:1;box-sizing:border-box}
:global(#wallpaper-viewer .vb-ico){width:16px;height:16px;flex:none;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
:global(#wallpaper-viewer .viewer-grid-toggle .vb-ico){fill:currentColor;stroke:none;width:13px;height:13px}
#wallpaper-viewer .viewer-tools{align-items:center}
#wallpaper-viewer .gallery-total{line-height:1;padding:3px 6px}
</style>

---
import gallery from '../data/destiny-gallery.json'
const wallpapers=gallery.map(w=>({...w,film:w.src.replace('/destiny/','/destiny/film/')}))
import tour from '../data/destiny-tour.json'
import drawingScore from '../data/drawing-score.json'
import musicGrid from '../data/music-grid.json'
import introFrames from '../data/intro-framing.json'
const tourDuration = 299.21
const chapters = tour.filter(s => s.chapter && !["Prolog", "Finał"].includes(s.chapter))
const cover = wallpapers.find(w => w.id === 'o01') || wallpapers[0]
---
<section class="wallpaper-entry" aria-label="Galeria tapet">
  <button class="gallery-launch" type="button" aria-haspopup="dialog" aria-controls="wallpaper-viewer">
    <img src={cover.thumb} width="5120" height="2160" alt="" />
    <span class="gallery-teaser" aria-hidden="true" hidden><span class="teaser-frame"><img alt="" /></span><span class="teaser-caption"></span><span class="teaser-progress"></span></span>
    <span class="gallery-invite"><span><strong>Wejdź do akwarium</strong><small>Film z muzyką · galeria 42 tapet</small></span><span class="entry-arrow" aria-hidden="true">↗</span></span>
  </button>
  <noscript><p><a href={cover.src}>Otwórz tapetę w pełnej rozdzielczości</a> · <a href="https://github.com/ncr/omarchy-destiny-theme/tree/ultrawide/backgrounds">Cała kolekcja</a></p></noscript>
</section>
<dialog class="music-surface" id="wallpaper-viewer" aria-label="Galeria 42 tapet" data-cover={wallpapers.indexOf(cover)}>
  <div class="gallery-shell">
    <header class="viewer-top">
      <div class="viewer-label" aria-live="polite" aria-atomic="true"><span class="viewer-count"></span><h2 class="viewer-title"></h2></div>
      <button type="button" class="viewer-close icon-button" aria-label="Zamknij galerię" title="Zamknij (Esc)">✕</button>
    </header>
    <div class="viewer-canvas" tabindex="0" aria-label="Tapeta. Strzałki zmieniają obraz, Z przełącza powiększenie.">
      <div class="scene-bridge" aria-hidden="true" hidden><div class="scene-bridge-frame"><img alt="" /></div></div>
      <div class="viewer-frame"><img class="viewer-preview" alt="" /><img class="viewer-image" alt="" /></div>
    </div>
    <p class="viewer-error" role="status" hidden>Nie udało się wczytać pełnego obrazu. <button type="button" class="viewer-retry">Spróbuj ponownie</button></p>
    <button type="button" class="viewer-prev edge-nav icon-button" aria-label="Poprzednia tapeta" title="Poprzednia (←)">‹</button>
    <button type="button" class="viewer-next edge-nav icon-button" aria-label="Następna tapeta" title="Następna (→)">›</button>
    <section class="tour-player" aria-label="Oprowadzanie po detalach" hidden>
      <p class="tour-caption" aria-live="polite" aria-atomic="true"></p>
      <div class="tour-controls">
        <button type="button" class="tour-play" aria-label="Odtwórz oprowadzanie">▶</button>
        <div class="tour-track"><input class="tour-seek" type="range" min="0" max={tourDuration} step="0.01" value="0" aria-label="Czas oprowadzania" /><div class="tour-chapters">{chapters.map(s => <button type="button" data-time={s.at} style={`left:${s.at/tourDuration*100}%`} title={s.chapter} aria-label={`Rozdział: ${s.chapter}`}><span>{{Maszyna:"Moduł",Zastępstwo:"Robot",Podróż:"Statek",Kolacja:"Kolacja",Sąsiedzi:"Płot",Oddech:"Żagiel"}[s.chapter!] || s.chapter}</span></button>)}</div></div>
        <span class="tour-time">0:00 / 4:59</span>
      </div>
      <section class="tour-audio" aria-label="Muzyka do pokazu">
        <img class="music-art" src="https://omarchy.org/music/kevin_koontz-we_can_fix_everything.webp" alt="Okładka utworu We Can Fix Everything" width="88" height="88" loading="lazy" />
        <div class="music-identity"><span class="music-eyebrow">Dźwięk tego akwarium</span><a class="music-title" href="https://omarchy.org/" target="_blank" rel="noopener">We Can Fix Everything <span aria-hidden="true">↗</span></a><span class="music-artist">Kevin Koontz <span class="music-version">· The Ultimate Machine</span></span></div>
        <div class="music-actions"><button type="button" class="music-toggle" aria-pressed="false" aria-label="Włącz dźwięk"><span class="music-button-icon" aria-hidden="true">♫</span><span class="music-button-label">Włącz dźwięk</span></button><label class="music-volume-label"><span>Głośność</span><input class="music-volume" type="range" min="0" max="1" step="0.01" value="0.45" aria-label="Głośność muzyki" /></label><button type="button" class="music-hide" aria-label="Schowaj odtwarzacz. Muzyka będzie grała dalej." title="Schowaj odtwarzacz">−</button></div>
        <div class="music-footnote"><span class="music-playing"><span class="music-meter" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span class="music-playback-label">Posłuchaj razem z obrazem</span></span><span class="music-status" role="status"></span></div>
      </section>
      <audio class="tour-music" preload="none"></audio>
    </section>
    <footer class="viewer-bottom">
      <button type="button" class="tour-return">▷ <span>Odtwórz pokaz</span></button>
      <button type="button" class="viewer-grid-toggle" aria-expanded="false" aria-controls="viewer-grid">▦ <span>Otwórz galerię</span><span class="gallery-total">42</span></button>
      <div class="viewer-tools">
        <button type="button" class="viewer-zoom" aria-pressed="false" title="Powiększenie (Z)">＋ <span>Detal</span></button>
        <button type="button" class="viewer-fx" aria-pressed="true" aria-label="Animacje tapet i efekty 3D" title="Włącz lub wyłącz animacje tapet i efekty 3D">◇ <span>Animacje</span></button>
        <button type="button" class="viewer-fullscreen" aria-label="Pełny ekran" aria-pressed="false" title="Pełny ekran (F)">⛶ <span>Pełny ekran</span></button>
        <a class="viewer-download" aria-label="Pobierz tapetę" download title="Pobierz oryginał 5120 × 2160">↓ <span>Pobierz</span></a>
      </div>
    </footer>
    <section id="viewer-grid" aria-label="Wybierz tapetę" hidden>
      <div class="grid-heading"><p>Wybierz tapetę · 42 obrazy</p><button type="button" class="grid-close icon-button" aria-label="Wróć do oglądania" title="Wróć do oglądania">✕</button></div>
      <div class="wallpaper-grid">
        {wallpapers.map((w, i) => <button type="button" data-index={i} aria-label={`${i + 1}. ${w.name}`}><img src={w.thumb} alt="" width="5120" height="2160" loading="lazy" /><span>{w.name}</span></button>)}
      </div>
    </section>
  </div>
</dialog>
<script>
  import "../scripts/flight-controller.js";
  import "../scripts/ambient-controller.js";
  import "../scripts/audio-reactivity.js";
</script>
<script define:vars={{musicGrid, introFrames, wallpapers, tour, tourDuration, drawingScore }}>
  (() => {
    const dialog = document.querySelector('#wallpaper-viewer');
    const q = s => dialog.querySelector(s) || document.querySelector(s);
    const launch = document.querySelector('.gallery-launch');
    const canvas = q('.viewer-canvas'), frame = q('.viewer-frame');
    const photo = q('.viewer-image'), preview = q('.viewer-preview');
    const bridge=q('.scene-bridge'),bridgeFrame=q('.scene-bridge-frame'),bridgeImage=bridge.querySelector('img'),surface={width:0,height:0};let bridgeKey='',frameSize='';
    const decoded=new Map();
    function warmImage(w){
      if(decoded.has(w.id))return decoded.get(w.id).ready;
      const image=new Image();image.src=w.film;const entry={image,ready:image.decode().then(()=>image)};entry.ready.catch(()=>{});decoded.set(w.id,entry);
      while(decoded.size>5)decoded.delete(decoded.keys().next().value);
      return entry.ready;
    }
    const grid = q('#viewer-grid'), gridToggle = q('.viewer-grid-toggle');
    const zoomButton = q('.viewer-zoom'), fullscreenButton = q('.viewer-fullscreen');
    let index = Number(dialog.dataset.cover), zoom = false, previousOverflow = '', touchStart = null, drag = null, request = 0, ownsFullscreen = false;
    function setZoom(value) {
      if(value && touring) leaveTour();
      zoom = value; canvas.classList.toggle('is-zoomed', zoom);
      zoomButton.setAttribute('aria-pressed', String(zoom));
      zoomButton.innerHTML = zoom ? '− <span>Całość</span>' : '＋ <span>Detal</span>';
      requestAnimationFrame(() => { canvas.scrollLeft = zoom ? (canvas.scrollWidth - canvas.clientWidth) / 2 : 0; canvas.scrollTop = zoom ? (canvas.scrollHeight - canvas.clientHeight) / 2 : 0; });
    }
    function setGrid(value) {
      grid.hidden = !value; gridToggle.setAttribute('aria-expanded',String(value));
      dialog.classList.toggle('grid-open',value);
      if(value) { leaveTour(); const selected=grid.querySelector(`[data-index="${index}"]`); selected.focus(); selected.scrollIntoView({block:'nearest'}); }
      else canvas.focus({preventScroll:true});
    }
    function show(next, fromTour = false) {
      if(!fromTour && touring) leaveTour();
      index = (next + wallpapers.length) % wallpapers.length;
      const w = wallpapers[index]; const ticket = ++request;
      window.dispatchEvent(new CustomEvent('destiny-wallpaper',{detail:w}));
      setZoom(false); q('.viewer-error').hidden = true;
      q('.viewer-count').textContent = `${String(index+1).padStart(2,'0')} / ${wallpapers.length}`;
      q('.viewer-title').textContent=fromTour&&time<musicGrid.firstReveal?'Światło i linie':w.name;
      q('.viewer-download').href=w.src;
      preview.style.visibility='visible'; preview.src=w.thumb; photo.style.visibility='hidden'; photo.alt=w.name;
      const source=fromTour?w.film:w.src;
      const ready=fromTour?warmImage(w):(()=>{const image=new Image();image.src=source;return image.decode().then(()=>image);})();
      ready.then(async()=>{if(ticket!==request)return;photo.src=source;try{await photo.decode();}catch{}if(ticket!==request)return;photo.style.visibility='visible';preview.style.visibility='hidden';}).catch(()=>{if(ticket===request)q('.viewer-error').hidden=false;});
      grid.querySelectorAll('[data-index]').forEach(b=>b.setAttribute('aria-current',String(Number(b.dataset.index)===index)));
    }
    launch.addEventListener('click',()=> { previousOverflow=document.body.style.overflow; document.body.style.overflow='hidden'; dialog.showModal(); grid.hidden=true; dialog.classList.remove('grid-open'); gridToggle.setAttribute('aria-expanded','false'); returnMusic(); startTour(hasOpened); hasOpened=true; if(soundPreference()==='on'&&!music)soundButton.click(); q('.viewer-close').focus(); });
    let closingRect=null,hasOpened=false;
    async function close() { closingRect=q('.tour-audio').getBoundingClientRect(); if(ownsFullscreen && document.fullscreenElement) await document.exitFullscreen().catch(()=>{}); ownsFullscreen=false; dialog.close(); }
    dialog.addEventListener('close',()=> {cancelAnimationFrame(tickId);document.body.style.overflow=previousOverflow;dockMusic(closingRect);closingRect=null;launch.focus({preventScroll:true});});
    dialog.addEventListener('cancel',e=> {if(!grid.hidden){e.preventDefault();setGrid(false);}else if(zoom){e.preventDefault();setZoom(false);}else{e.preventDefault();close();}});
    q('.viewer-close').onclick=close;
    q('.viewer-prev').onclick=()=>show(index-1); q('.viewer-next').onclick=()=>show(index+1);
    q('.viewer-retry').onclick=()=>show(index,touring);
    gridToggle.onclick=()=>setGrid(grid.hidden); q('.grid-close').onclick=()=>setGrid(false);
    grid.querySelectorAll('[data-index]').forEach(b=>b.onclick=()=> {show(Number(b.dataset.index));setGrid(false);});
    zoomButton.onclick=()=>setZoom(!zoom);
    async function fullscreen() {try {if(document.fullscreenElement) await document.exitFullscreen(); else { await document.documentElement.requestFullscreen(); ownsFullscreen=true; }} catch (error) { console.warn("Fullscreen unavailable:", error); } }
    if(!document.fullscreenEnabled) fullscreenButton.hidden=true;
    fullscreenButton.onclick=fullscreen;
    document.addEventListener('fullscreenchange',()=>fullscreenButton.setAttribute('aria-pressed',String(Boolean(document.fullscreenElement))));
    dialog.addEventListener('keydown',e=> {
      if(!grid.hidden || e.target.matches('input')) return;
      if(touring && (e.key==='ArrowRight'||e.key==='ArrowLeft')) {e.preventDefault();scrub(time+(e.key==='ArrowRight'?5:-5));return;}
      if(touring && e.code==='Space' && (e.target===canvas || e.target===q('.tour-play'))) {e.preventDefault();togglePlay();return;}
      if(touring && (e.key==='Home'||e.key==='End')) {e.preventDefault();scrub(e.key==='Home'?0:duration);return;}
      if(e.key==='ArrowRight'||e.key==='ArrowLeft') {e.preventDefault();show(index+(e.key==='ArrowRight'?1:-1));}
      if(e.key.toLowerCase()==='z'){e.preventDefault();setZoom(!zoom);}
      if(e.key.toLowerCase()==='f'){e.preventDefault();fullscreen();}
      if(e.key==='Home'){e.preventDefault();show(0);} if(e.key==='End'){e.preventDefault();show(wallpapers.length-1);}
    });
    canvas.addEventListener('dblclick',()=>setZoom(!zoom));
    canvas.addEventListener('touchstart',e=> {if(e.touches.length===1&&!zoom&&!touring) touchStart={x:e.touches[0].clientX,y:e.touches[0].clientY}; else touchStart=null;},{passive:true});
    canvas.addEventListener('touchend',e=> {if(!touchStart||zoom)return;const dx=e.changedTouches[0].clientX-touchStart.x,dy=e.changedTouches[0].clientY-touchStart.y;if(Math.abs(dx)>50&&Math.abs(dx)>Math.abs(dy)*1.4)show(index+(dx<0?1:-1));touchStart=null;},{passive:true});
    canvas.addEventListener('pointerdown',e=> {if(zoom&&e.pointerType==='mouse'){drag={x:e.clientX,y:e.clientY,left:canvas.scrollLeft,top:canvas.scrollTop};canvas.setPointerCapture(e.pointerId);e.preventDefault();}});
    canvas.addEventListener('pointermove',e=> {if(drag){canvas.scrollLeft=drag.left+drag.x-e.clientX;canvas.scrollTop=drag.top+drag.y-e.clientY;}});
    canvas.addEventListener('pointerup',()=>drag=null); canvas.addEventListener('pointercancel',()=>drag=null);

    const player=q('.tour-player'), seek=q('.tour-seek'), play=q('.tour-play');
    const reduced=matchMedia('(prefers-reduced-motion: reduce)');
    const duration=tourDuration, soundtrackOffset=0;
    const audio=q('.tour-music'), soundButton=q('.music-toggle');
    // The media element stays in one DOM location throughout every visual transition.
    dialog.after(audio);
    const musicCard=q('.tour-audio'), musicHome=musicCard.parentNode;
    const dock=document.querySelector('#soundtrack-dock'), reveal=document.querySelector('.soundtrack-reveal');
    let cardAnimation,hintTimer;
    function moveCard(from){
      cardAnimation?.cancel();
      if(reduced.matches||!from?.width||!from?.height)return;
      const to=musicCard.getBoundingClientRect();
      cardAnimation=musicCard.animate([{transform:`translate(${from.left-to.left}px,${from.top-to.top}px) scale(${from.width/to.width},${from.height/to.height})`,transformOrigin:'0 0'},{transform:'none',transformOrigin:'0 0'}],{duration:620,easing:'cubic-bezier(.22,.8,.2,1)'});
    }
    function dockMusic(from){dock.hidden=false;dock.append(musicCard);musicCard.classList.add('is-docked');reveal.setAttribute('aria-expanded','true');moveCard(from);}
    function returnMusic(){cardAnimation?.cancel();musicHome.append(musicCard);musicCard.classList.remove('is-docked');dock.hidden=true;reveal.setAttribute('aria-expanded','false');clearTimeout(hintTimer);q('.soundtrack-hint').textContent='';}
    function hideDock(){
      cardAnimation?.cancel();const from=musicCard.getBoundingClientRect(),to=reveal.getBoundingClientRect();
      const finish=()=>{dock.hidden=true;reveal.setAttribute('aria-expanded','false');reveal.focus({preventScroll:true});q('.soundtrack-hint').textContent='Muzyka jest tutaj';clearTimeout(hintTimer);hintTimer=setTimeout(()=>q('.soundtrack-hint').textContent='',3200);};
      if(reduced.matches){finish();return;}
      cardAnimation=musicCard.animate([{transform:'none',opacity:1},{transform:`translate(${to.left+to.width/2-from.left-from.width/2}px,${to.top+to.height/2-from.top-from.height/2}px) scale(.08)`,opacity:0}],{duration:360,easing:'cubic-bezier(.4,0,.2,1)'});cardAnimation.onfinish=finish;
    }
    q('.music-hide').onclick=hideDock;
    reveal.onclick=()=>{if(!dock.hidden){hideDock();return;}clearTimeout(hintTimer);q('.soundtrack-hint').textContent='';dockMusic(reveal.getBoundingClientRect());};
    new ResizeObserver(()=>{document.documentElement.style.scrollPaddingTop=`${document.querySelector('.masthead').offsetHeight+16}px`;}).observe(document.querySelector('.masthead'));
    function soundPreference(){return document.cookie.split('; ').find(c=>c.startsWith('destiny-sound='))?.split('=')[1];}
    if(soundPreference())soundButton.dataset.engaged='true';
    let touring=false, playing=false, time=0, tickId=0, lastTick=0, currentShot=-1;
    let music=false, audioPending=false, audioGeneration=0, musicLoading=false;
    function soundState(){soundButton.setAttribute('aria-pressed',String(music));q('.music-button-label').textContent=music?'Wycisz':'Włącz dźwięk';soundButton.setAttribute('aria-label',music?'Wycisz muzykę':'Włącz dźwięk');}
    function pauseTour(){playing=false;audioGeneration++;audio.pause();cancelAnimationFrame(tickId);play.textContent='▶';play.setAttribute('aria-label','Odtwórz oprowadzanie');}
    function clock(t){return `${Math.floor(t/60)}:${String(Math.floor(t%60)).padStart(2,'0')}`;}
    function audioStart(){
      if(!music||!playing||audioPending||audio.readyState<1)return;
      audioPending=true;const generation=audioGeneration;
      audio.play().then(()=>{if(!playing||!music||generation!==audioGeneration)audio.pause();}).catch(error=>{if(error.name==='AbortError')return;music=false;soundState();q('.music-status').textContent='Muzyka niedostępna. Obraz gra dalej.';}).finally(()=>audioPending=false);
    }
    function audioSeek(){if(audio.src)try{audio.currentTime=soundtrackOffset+time;}catch{}}
    soundButton.onclick=()=>{
      soundButton.dataset.engaged='true';music=!music;
      document.cookie=`destiny-sound=${music?'on':'off'}; Max-Age=31536000; Path=/; SameSite=Lax${location.protocol==='https:'?'; Secure':''}`;
      audioGeneration++;q('.music-status').textContent='';soundState();
      if(music){
        if(!audio.src&&!musicLoading){
          musicLoading=true;q('.music-status').textContent='Wczytuję muzykę…';
          fetch('https://raw.githubusercontent.com/omacom/omarchy-site/master/public/music/kevin_koontz-we_can_fix_everything.mp3')
            .then(r=>{if(!r.ok)throw Error('music');return r.blob();})
            .then(blob=>{audio.src=URL.createObjectURL(blob);audio.load();q('.music-status').textContent='';})
            .catch(()=>{music=false;soundState();q('.music-status').textContent='Muzyka niedostępna. Obraz gra dalej.';})
            .finally(()=>musicLoading=false);
        }
        audio.volume=Number(q('.music-volume').value);audioSeek();if(!playing)togglePlay();else audioStart();
      }
      else audio.pause();
    };
    function playbackState(){
      const audible=music&&!audio.paused&&!audio.seeking&&audio.readyState>=3&&audio.volume>0;
      musicCard.classList.toggle('is-sounding',audible);reveal.classList.toggle('is-sounding',audible);
      q('.music-playback-label').textContent=audible?'Teraz gra · muzyka prowadzi światło':music?(playing?'Czekam na muzykę…':'Pauza · wznów pokaz'):'Posłuchaj razem z obrazem';
    }
    for(const event of ['playing','pause','waiting','seeking','seeked','volumechange'])audio.addEventListener(event,playbackState);
    q('.music-volume').addEventListener('input',e=>{audio.volume=Number(e.target.value);playbackState();});
    soundButton.addEventListener('click',playbackState);
    q('.music-art').addEventListener('error',e=>{e.target.style.visibility='hidden';});
    audio.addEventListener('loadedmetadata',()=>{audioSeek();audioStart();});
    audio.addEventListener('ended',()=>{seekTour(duration);pauseTour();});
    audio.addEventListener('error',()=>{music=false;soundState();q('.music-status').textContent='Muzyka niedostępna. Obraz gra dalej.';});
    let effects=true;
    q('.viewer-fx').onclick=()=>{effects=!effects;q('.viewer-fx').setAttribute('aria-pressed',String(effects));camera();};
    function flightEvent(active,paper){window.dispatchEvent(new CustomEvent('destiny-camera',{detail:{time,active,enabled:effects,paper}}));}
    dialog.addEventListener('close',()=>flightEvent(false));
    const captionElement=q('.tour-caption'),timeLabel=q('.tour-time');let captionSpans=[],lastClock='';
    const orbitPhrase=musicGrid.phrases.find(p=>p.kind==='orbit');
    const orbitMotionPlan={beats:orbitPhrase.beats.map(t=>t-orbitPhrase.start),seed:102,pullBeat:8,revealBeat:12};
    // Same beat interpolation as the offline operator; native paper and WebGL share the score.
    const easeScore=t=>{t=Math.max(0,Math.min(1,t));return t*t*t*(t*(t*6-15)+10);};
    function scoreBeat(p,t){
      if(!p.beats)return 0;const b=p.beats;if(t<b[0])return (t-b[0])/(b[1]-b[0]);let i=0;while(i<b.length-2&&b[i+1]<=t)i++;
      return i+Math.max(0,Math.min(1,(t-b[i])/(b[i+1]-b[i])));
    }
    function phraseMotion(p,t){
      if(!p?.beats)return {roll:0,zoom:1,pan:0,light:1,pulse:0};
      const b=scoreBeat(p,t),u=b-Math.floor(b),clock=Math.floor(b)+u+.65*Math.sin(2*Math.PI*u)/(2*Math.PI);
      const settle=1-easeScore((clock-p.pullBeat)/(p.revealBeat-p.pullBeat)),ready=easeScore((b-(p.pullBeat-4))/4),sign=p.seed%2?1:-1;
      const pulse=Math.pow((1+Math.cos(2*Math.PI*b))/2,5)*easeScore(b-(p.pullBeat-1))*(1-easeScore(b-15));
      return {roll:sign*(16*ready*settle+.9*pulse*settle),zoom:1+.032*pulse,pan:.003*Math.sin(Math.PI*b/2)*pulse,light:1+.055*pulse,pulse};
    }
    function scorePull(p,t){
      if(!p.beats)return Math.max(0,Math.min(1,(t-p.followEnd)/(p.holdStart-p.followEnd)));
      const b=p.beats;let i=0;while(i<b.length-2&&b[i+1]<=t)i++;
      const beat=i+Math.max(0,Math.min(1,(t-b[i])/(b[i+1]-b[i])));
      return Math.max(0,Math.min(1,(beat-p.pullBeat)/(p.revealBeat-p.pullBeat)));
    }
    function composition(at){
      let n=tour.findLastIndex(s=>s.at<=at);n=Math.max(0,n);
      const shot=tour[n], elapsed=at-shot.at;
      const previous=n>0&&tour[n-1].id===shot.id&&shot.motion!=='cut'?tour[n-1]:shot;
      const travel=shot.travel||(shot.motion==='float'?2.8:shot.motion==='pan'?1.8:1.15);
      let u=reduced.matches?1:Math.min(1,elapsed/travel);u=u*u*(3-2*u);
      let x=previous.x+(shot.x-previous.x)*u,y=previous.y+(shot.y-previous.y)*u;
      const shotDrift=(s,t)=>s.w>=.9&&s.h>=.9?1+.05*(1-Math.exp(-t/8)):1-Math.min(t,4)*.007;
      const drift=reduced.matches?1:shotDrift(shot,elapsed);
      const priorDuration=n>0?shot.at-tour[n-1].at:0;
      const startDrift=previous===shot||reduced.matches?1:shotDrift(previous,priorDuration);
      let w=Math.exp(Math.log(previous.w*startDrift)*(1-u)+Math.log(shot.w)*u)*drift;
      let h=Math.exp(Math.log(previous.h*startDrift)*(1-u)+Math.log(shot.h)*u)*drift;
      let paperPull=null;
      const passage=drawingScore.find(s=>s.id===shot.id&&at>=s.start&&at<s.end);
      if(passage&&effects&&!reduced.matches){
        const elapsed=at-passage.start,u=scorePull(passage,elapsed);
        const pull=easeScore(u),f=passage.framing;
        x=f.x+(.5-f.x)*pull;y=f.y+(.5-f.y)*pull;

---
import wallpapers from '../data/destiny-gallery.json'
import tour from '../data/destiny-tour.json'
const tourDuration = 74.46
const chapters = tour.filter(s => s.chapter)
const cover = wallpapers.find(w => w.id === 'o01') || wallpapers[0]
---
<section class="wallpaper-entry" aria-label="Galeria tapet">
  <button class="gallery-launch" type="button" aria-haspopup="dialog" aria-controls="wallpaper-viewer">
    <img src={cover.thumb} width="5120" height="2160" alt="" />
    <span class="gallery-invite"><span><strong>Wejdź do akwarium</strong><small>6 małych historii · obraz, rytm i detale</small></span><span class="entry-arrow" aria-hidden="true">↗</span></span>
  </button>
  <noscript><p><a href={cover.src}>Otwórz tapetę w pełnej rozdzielczości</a> · <a href="https://github.com/ncr/omarchy-destiny-theme/tree/ultrawide/backgrounds">Cała kolekcja</a></p></noscript>
</section>
<dialog id="wallpaper-viewer" aria-label="Galeria 42 tapet" data-cover={wallpapers.indexOf(cover)}>
  <div class="gallery-shell">
    <header class="viewer-top">
      <div class="viewer-label" aria-live="polite" aria-atomic="true"><span class="viewer-count"></span><h2 class="viewer-title"></h2></div>
      <button type="button" class="viewer-close icon-button" aria-label="Zamknij galerię" title="Zamknij (Esc)">✕</button>
    </header>
    <div class="viewer-canvas" tabindex="0" aria-label="Tapeta. Strzałki zmieniają obraz, Z przełącza powiększenie.">
      <div class="viewer-frame"><img class="viewer-preview" alt="" /><img class="viewer-image" alt="" /></div>
    </div>
    <p class="viewer-error" role="status" hidden>Nie udało się wczytać pełnego obrazu. <button type="button" class="viewer-retry">Spróbuj ponownie</button></p>
    <button type="button" class="viewer-prev edge-nav icon-button" aria-label="Poprzednia tapeta" title="Poprzednia (←)">‹</button>
    <button type="button" class="viewer-next edge-nav icon-button" aria-label="Następna tapeta" title="Następna (→)">›</button>
    <section class="tour-player" aria-label="Oprowadzanie po detalach" hidden>
      <p class="tour-caption" aria-live="polite" aria-atomic="true"></p>
      <div class="tour-controls">
        <button type="button" class="tour-play" aria-label="Odtwórz oprowadzanie">▶</button>
        <div class="tour-track"><input class="tour-seek" type="range" min="0" max={tourDuration} step="0.01" value="0" aria-label="Czas oprowadzania" /><div class="tour-chapters">{chapters.map(s => <button type="button" data-time={s.at} style={`left:${s.at/tourDuration*100}%`} title={s.chapter} aria-label={`Rozdział: ${s.chapter}`}><span>{{Maszyna:"Moduł",Zastępstwo:"Robot",Podróż:"Statek",Kolacja:"Kolacja",Sąsiedzi:"Płot",Oddech:"Żagiel"}[s.chapter!]}</span></button>)}</div></div>
        <span class="tour-time">0:00 / 1:14</span>
      </div>
      <div class="tour-audio"><button type="button" class="music-toggle" aria-pressed="false">♫ Włącz muzykę</button><a href="https://omarchy.org/" target="_blank" rel="noopener">Kevin Koontz · We Can Fix Everything ↗</a><span class="music-status" role="status"></span></div>
      <audio class="tour-music" preload="none"></audio>
    </section>
    <footer class="viewer-bottom">
      <button type="button" class="tour-return">▷ <span>Odtwórz pokaz</span></button>
      <button type="button" class="viewer-grid-toggle" aria-expanded="false" aria-controls="viewer-grid">▦ <span>Otwórz galerię</span><span class="gallery-total">42</span></button>
      <div class="viewer-tools">
        <button type="button" class="viewer-zoom" aria-pressed="false" title="Powiększenie (Z)">＋ <span>Detal</span></button>
        <button type="button" class="viewer-fullscreen" aria-label="Pełny ekran" aria-pressed="false" title="Pełny ekran (F)">⛶ <span>Pełny ekran</span></button>
        <a class="viewer-download" aria-label="Pobierz tapetę" download title="Pobierz oryginał 5120 × 2160">↓ <span>Pobierz</span></a>
      </div>
    </footer>
    <section id="viewer-grid" aria-label="Wybierz tapetę" hidden>
      <div class="grid-heading"><p>Wybierz tapetę · 42 obrazy</p><button type="button" class="grid-close icon-button" aria-label="Wróć do oglądania" title="Wróć do oglądania">✕</button></div>
      <div class="wallpaper-grid">
        {wallpapers.map((w, i) => <button type="button" data-index={i} aria-label={`${i + 1}. ${w.name}`}><img src={w.thumb} alt="" width="5120" height="2160" loading="lazy" /><span>{w.name}</span></button>)}
      </div>
    </section>
  </div>
</dialog>
<script define:vars={{ wallpapers, tour, tourDuration }}>
  (() => {
    const dialog = document.querySelector('#wallpaper-viewer');
    const q = s => dialog.querySelector(s);
    const launch = document.querySelector('.gallery-launch');
    const canvas = q('.viewer-canvas'), frame = q('.viewer-frame');
    const photo = q('.viewer-image'), preview = q('.viewer-preview');
    const grid = q('#viewer-grid'), gridToggle = q('.viewer-grid-toggle');
    const zoomButton = q('.viewer-zoom'), fullscreenButton = q('.viewer-fullscreen');
    let index = Number(dialog.dataset.cover), zoom = false, previousOverflow = '', touchStart = null, drag = null, request = 0, ownsFullscreen = false;
    function setZoom(value) {
      if(value && touring) leaveTour();
      zoom = value; canvas.classList.toggle('is-zoomed', zoom);
      zoomButton.setAttribute('aria-pressed', String(zoom));
      zoomButton.innerHTML = zoom ? '− <span>Całość</span>' : '＋ <span>Detal</span>';
      requestAnimationFrame(() => { canvas.scrollLeft = zoom ? (canvas.scrollWidth - canvas.clientWidth) / 2 : 0; canvas.scrollTop = zoom ? (canvas.scrollHeight - canvas.clientHeight) / 2 : 0; });
    }
    function setGrid(value) {
      grid.hidden = !value; gridToggle.setAttribute('aria-expanded',String(value));
      dialog.classList.toggle('grid-open',value);
      if(value) { leaveTour(); const selected=grid.querySelector(`[data-index="${index}"]`); selected.focus(); selected.scrollIntoView({block:'nearest'}); }
      else canvas.focus({preventScroll:true});
    }
    function show(next, fromTour = false) {
      if(!fromTour && touring) leaveTour();
      index = (next + wallpapers.length) % wallpapers.length;
      const w = wallpapers[index]; const ticket = ++request;
      setZoom(false); q('.viewer-error').hidden = true;
      q('.viewer-count').textContent = `${String(index+1).padStart(2,'0')} / ${wallpapers.length}`;
      q('.viewer-title').textContent=w.name;
      q('.viewer-download').href=w.src;
      preview.style.visibility='visible'; preview.src=w.thumb; photo.style.visibility='hidden'; photo.alt=w.name;
      const load=new Image();
      load.onload=async()=> { if(ticket!==request) return; photo.src=w.src; try { await photo.decode(); } catch {} if(ticket!==request) return; photo.style.visibility='visible'; preview.style.visibility='hidden'; };
      load.onerror=()=> {if(ticket===request) q('.viewer-error').hidden=false;};
      load.src=w.src;
      grid.querySelectorAll('[data-index]').forEach(b=>b.setAttribute('aria-current',String(Number(b.dataset.index)===index)));
    }
    launch.addEventListener('click',()=> { previousOverflow=document.body.style.overflow; document.body.style.overflow='hidden'; dialog.showModal(); grid.hidden=true; dialog.classList.remove('grid-open'); gridToggle.setAttribute('aria-expanded','false'); startTour(); q('.viewer-close').focus(); });
    async function close() { if(ownsFullscreen && document.fullscreenElement) await document.exitFullscreen().catch(()=>{}); ownsFullscreen=false; dialog.close(); }
    dialog.addEventListener('close',()=> {pauseTour();document.body.style.overflow=previousOverflow; launch.focus({preventScroll:true});});
    dialog.addEventListener('cancel',e=> {if(!grid.hidden){e.preventDefault();setGrid(false);}else if(zoom){e.preventDefault();setZoom(false);}});
    q('.viewer-close').onclick=close;
    q('.viewer-prev').onclick=()=>show(index-1); q('.viewer-next').onclick=()=>show(index+1);
    q('.viewer-retry').onclick=()=>show(index);
    gridToggle.onclick=()=>setGrid(grid.hidden); q('.grid-close').onclick=()=>setGrid(false);
    grid.querySelectorAll('[data-index]').forEach(b=>b.onclick=()=> {show(Number(b.dataset.index));setGrid(false);});
    zoomButton.onclick=()=>setZoom(!zoom);
    async function fullscreen() {try {if(document.fullscreenElement) await document.exitFullscreen(); else { await document.documentElement.requestFullscreen(); ownsFullscreen=true; }} catch (error) { console.warn("Fullscreen unavailable:", error); } }
    if(!document.fullscreenEnabled) fullscreenButton.hidden=true;
    fullscreenButton.onclick=fullscreen;
    document.addEventListener('fullscreenchange',()=>fullscreenButton.setAttribute('aria-pressed',String(Boolean(document.fullscreenElement))));
    dialog.addEventListener('keydown',e=> {
      if(!grid.hidden || e.target.matches('input')) return;
      if(touring && (e.key==='ArrowRight'||e.key==='ArrowLeft')) {e.preventDefault();scrub(time+(e.key==='ArrowRight'?5:-5));return;}
      if(touring && e.code==='Space' && (e.target===canvas || e.target===q('.tour-play'))) {e.preventDefault();togglePlay();return;}
      if(touring && (e.key==='Home'||e.key==='End')) {e.preventDefault();scrub(e.key==='Home'?0:duration);return;}
      if(e.key==='ArrowRight'||e.key==='ArrowLeft') {e.preventDefault();show(index+(e.key==='ArrowRight'?1:-1));}
      if(e.key.toLowerCase()==='z'){e.preventDefault();setZoom(!zoom);}
      if(e.key.toLowerCase()==='f'){e.preventDefault();fullscreen();}
      if(e.key==='Home'){e.preventDefault();show(0);} if(e.key==='End'){e.preventDefault();show(wallpapers.length-1);}
    });
    canvas.addEventListener('dblclick',()=>setZoom(!zoom));
    canvas.addEventListener('touchstart',e=> {if(e.touches.length===1&&!zoom&&!touring) touchStart={x:e.touches[0].clientX,y:e.touches[0].clientY}; else touchStart=null;},{passive:true});
    canvas.addEventListener('touchend',e=> {if(!touchStart||zoom)return;const dx=e.changedTouches[0].clientX-touchStart.x,dy=e.changedTouches[0].clientY-touchStart.y;if(Math.abs(dx)>50&&Math.abs(dx)>Math.abs(dy)*1.4)show(index+(dx<0?1:-1));touchStart=null;},{passive:true});
    canvas.addEventListener('pointerdown',e=> {if(zoom&&e.pointerType==='mouse'){drag={x:e.clientX,y:e.clientY,left:canvas.scrollLeft,top:canvas.scrollTop};canvas.setPointerCapture(e.pointerId);e.preventDefault();}});
    canvas.addEventListener('pointermove',e=> {if(drag){canvas.scrollLeft=drag.left+drag.x-e.clientX;canvas.scrollTop=drag.top+drag.y-e.clientY;}});
    canvas.addEventListener('pointerup',()=>drag=null); canvas.addEventListener('pointercancel',()=>drag=null);

    const player=q('.tour-player'), seek=q('.tour-seek'), play=q('.tour-play');
    const reduced=matchMedia('(prefers-reduced-motion: reduce)');
    const duration=tourDuration, soundtrackOffset=20.45;
    const audio=q('.tour-music'), soundButton=q('.music-toggle');
    let touring=false, playing=false, time=0, tickId=0, lastTick=0, currentShot=-1;
    let music=false, audioPending=false, audioGeneration=0, musicLoading=false;
    function soundState(){soundButton.setAttribute('aria-pressed',String(music));soundButton.textContent=music?'♫ Muzyka włączona':'♫ Włącz muzykę';}
    function pauseTour(){playing=false;audioGeneration++;audio.pause();cancelAnimationFrame(tickId);play.textContent='▶';play.setAttribute('aria-label','Odtwórz oprowadzanie');}
    function clock(t){return `${Math.floor(t/60)}:${String(Math.floor(t%60)).padStart(2,'0')}`;}
    function audioStart(){
      if(!music||!playing||audioPending||audio.readyState<1)return;
      audioPending=true;const generation=audioGeneration;
      audio.play().then(()=>{if(!playing||!music||generation!==audioGeneration)audio.pause();}).catch(error=>{if(error.name==='AbortError')return;music=false;soundState();q('.music-status').textContent='Muzyka niedostępna. Obraz gra dalej.';}).finally(()=>audioPending=false);
    }
    function audioSeek(){if(audio.src)try{audio.currentTime=soundtrackOffset+time;}catch{}}
    soundButton.onclick=()=>{
      music=!music;audioGeneration++;q('.music-status').textContent='';soundState();
      if(music){
        if(!audio.src&&!musicLoading){
          musicLoading=true;q('.music-status').textContent='Wczytuję muzykę…';
          fetch('https://raw.githubusercontent.com/omacom/omarchy-site/master/public/music/kevin_koontz-we_can_fix_everything.mp3')
            .then(r=>{if(!r.ok)throw Error('music');return r.blob();})
            .then(blob=>{audio.src=URL.createObjectURL(blob);audio.load();q('.music-status').textContent='';})
            .catch(()=>{music=false;soundState();q('.music-status').textContent='Muzyka niedostępna. Obraz gra dalej.';})
            .finally(()=>musicLoading=false);
        }
        audio.volume=.45;audioSeek();if(!playing)togglePlay();else audioStart();
      }
      else audio.pause();
    };
    audio.addEventListener('loadedmetadata',()=>{audioSeek();audioStart();});
    audio.addEventListener('error',()=>{music=false;soundState();q('.music-status').textContent='Muzyka niedostępna. Obraz gra dalej.';});
    function camera(){
      if(!touring)return;
      let n=tour.findLastIndex(s=>s.at<=time);n=Math.max(0,n);
      const shot=tour[n], elapsed=time-shot.at;
      const previous=n>0&&tour[n-1].id===shot.id&&shot.motion!=='cut'?tour[n-1]:shot;
      const travel=shot.motion==='float'?2.8:shot.motion==='pan'?1.8:1.15;
      let u=reduced.matches?1:Math.min(1,elapsed/travel);u=u*u*(3-2*u);
      const x=previous.x+(shot.x-previous.x)*u,y=previous.y+(shot.y-previous.y)*u;
      const drift=reduced.matches?1:1-Math.min(elapsed,4)*.007;
      const w=(previous.w+(shot.w-previous.w)*u)*drift,h=(previous.h+(shot.h-previous.h)*u)*drift;
      const cw=canvas.clientWidth,ch=canvas.clientHeight;
      const bw=Math.min(cw,ch*5120/2160),bh=bw*2160/5120;
      const scale=Math.min(cw/(bw*w),ch/(bh*h));
      frame.style.width=`${bw}px`;frame.style.height=`${bh}px`;
      frame.style.transform=`translate(${-x*bw*scale}px,${-y*bh*scale}px) scale(${scale})`;
      if(currentShot!==n){
        currentShot=n;
        const caption=q('.tour-caption');caption.replaceChildren();
        const words=shot.caption.split(' ');
        for(let i=0;i<words.length;i+=3){const span=document.createElement('span');span.textContent=words.slice(i,i+3).join(' ')+' ';span.className='caption-phrase';span.dataset.delay=String(i/3*.10);caption.append(span);}
        const next=wallpapers.findIndex(w=>w.id===shot.id);
        if(index!==next||!photo.getAttribute('src'))show(next,true);
        const upcoming=tour.slice(n+1).find(s=>s.id!==shot.id);
        if(upcoming){const preload=new Image();preload.src=wallpapers.find(w=>w.id===upcoming.id).src;}
        q('.tour-chapters').querySelectorAll('button').forEach(b=>b.setAttribute('aria-current',String(Number(b.dataset.time)<=time && !tour.some(s=>s.chapter&&s.at>Number(b.dataset.time)&&s.at<=time))));
      }
      q('.tour-caption').querySelectorAll('span').forEach(span=>{
        const reveal=reduced.matches?1:Math.max(0,Math.min(1,(elapsed-Number(span.dataset.delay))/.22));
        span.style.opacity=String(.45+.55*reveal);span.style.transform=`translateY(${(1-reveal)*5}px)`;
      });
      seek.value=String(time);seek.setAttribute('aria-valuetext',`${clock(time)} z ${clock(duration)}. ${shot.caption}`);
      q('.tour-time').textContent=`${clock(time)} / ${clock(duration)}`;
    }
    function seekTour(t){time=Math.max(0,Math.min(duration,t));camera();if(time===duration)pauseTour();}
    function tick(now){
      if(!playing||!dialog.open)return;
      if(photo.style.visibility!=='visible'){audio.pause();}
      else if(music){if(audio.paused)audioStart();if(!audio.paused&&!audio.seeking&&audio.readyState>=2)seekTour(audio.currentTime-soundtrackOffset);}
      else seekTour(time+Math.min((now-lastTick)/1000,.1));
      lastTick=now;if(playing)tickId=requestAnimationFrame(tick);
    }
    function togglePlay(){if(playing){pauseTour();return;}if(time>=duration)seekTour(0);playing=true;play.textContent='Ⅱ';play.setAttribute('aria-label','Wstrzymaj oprowadzanie');audioSeek();audioStart();lastTick=performance.now();tickId=requestAnimationFrame(tick);}
    function startTour(){pauseTour();setZoom(false);touring=true;dialog.classList.add('is-touring');player.hidden=false;q('.tour-return').hidden=true;currentShot=-1;seekTour(0);audioSeek();if(!reduced.matches)togglePlay();}
    function leaveTour(){pauseTour();touring=false;dialog.classList.remove('is-touring');player.hidden=true;q('.tour-return').hidden=false;frame.style.width='';frame.style.height='';frame.style.transform='';}
    play.onclick=togglePlay;
    function scrub(t){pauseTour();seekTour(t);audioSeek();}
    seek.addEventListener('input',()=>scrub(Number(seek.value)));
    seek.addEventListener('keydown',e=>{if(['ArrowLeft','ArrowRight','Home','End'].includes(e.key)){e.preventDefault();scrub(e.key==='Home'?0:e.key==='End'?duration:time+(e.key==='ArrowRight'?5:-5));}});
    q('.tour-return').onclick=startTour;
    q('.tour-track').querySelectorAll('[data-time]').forEach(b=>b.onclick=()=>scrub(Number(b.dataset.time)));
    new ResizeObserver(()=>camera()).observe(canvas);
    document.addEventListener('visibilitychange',()=>{if(document.hidden)pauseTour();});
    frame.addEventListener('dragstart',e=>e.preventDefault());
  })();
</script>
<style>
#wallpaper-viewer .viewer-grid-toggle{display:flex;align-items:center;gap:8px;background:#d7e8f7;color:#101722;font-weight:550;border:1px solid #eaf4ff}.gallery-total{font-size:11px;background:#13263d15;padding:2px 6px;border-radius:6px;font-variant-numeric:tabular-nums}.viewer-bottom{border-top:1px solid #ffffff0b}.viewer-top{border-bottom:1px solid #ffffff0b}.viewer-tools{align-items:center}.viewer-bottom .tour-return{border:1px solid #ffffff25!important}.tour-audio{margin-bottom:10px}.tour-caption{min-height:2.5em!important}
@media(max-width:700px){.viewer-bottom{flex-wrap:wrap;gap:6px;padding:10px 12px!important}.viewer-bottom button,.viewer-bottom a{font-size:11px!important;padding:8px!important}.viewer-tools{gap:0!important}.viewer-bottom .tour-return{order:3;width:100%}.viewer-grid-toggle{gap:5px!important}.tour-chapters button{padding-left:3px!important}.tour-caption{min-height:3.2em!important}.tour-audio{margin-bottom:6px}.gallery-total{font-size:10px!important}}

.caption-phrase{display:inline-block;white-space:pre;will-change:opacity,transform}.tour-caption{font-weight:550;letter-spacing:-.025em}.tour-audio{display:flex;align-items:center;justify-content:center;gap:12px;min-height:30px;font-size:11px;color:#8f9cb0;flex-wrap:wrap}.tour-audio a{color:inherit!important;text-decoration:none}.music-toggle{min-height:36px;border-radius:20px;padding:6px 12px}.music-toggle[aria-pressed=true]{background:#25384a!important;color:#c4e5ff!important}.music-status{font-size:11px}.tour-chapters [aria-current=true]{color:#c4e5ff!important;border-color:#92caff!important}
@media(max-width:700px){.tour-audio{gap:0 8px;font-size:9px}.tour-audio a{max-width:210px}.tour-chapters button span{display:inline;font-size:9px}.tour-chapters button{min-width:26px}.tour-caption{min-height:3em!important}.tour-controls{gap:5px!important}}

.tour-player{padding:8px 24px 0;z-index:2;background:#07090e}.tour-caption{max-width:760px;min-height:2.8em;margin:0 auto 14px;text-align:center;font-size:clamp(15px,1.5vw,21px);line-height:1.45;color:#e0e6f1;text-wrap:balance}.tour-controls{max-width:1000px;margin:auto;display:flex;align-items:start;gap:14px}.tour-play{width:44px;height:44px;border-radius:50%;font-size:22px!important}.tour-track{flex:1;min-width:0}.tour-seek{display:block;width:100%;height:28px;margin:8px 0 0;accent-color:#90caff;cursor:pointer}.tour-chapters{position:relative;height:30px;text-align:left;font-size:11px;color:#909bb0}.tour-chapters button{position:absolute;top:0;min-height:30px;text-align:left;border-left:1px solid #394252!important;border-radius:0;padding-left:6px}.tour-time{font-variant-numeric:tabular-nums;font-size:12px;white-space:nowrap;line-height:44px;color:#909bb0}.is-touring .gallery-shell{grid-template-rows:auto minmax(0,1fr) auto auto}.is-touring .viewer-frame{position:absolute;left:50%;top:50%;transform-origin:0 0;will-change:transform}.is-touring .edge-nav,.is-touring .viewer-zoom{display:none!important}.is-touring .viewer-canvas{touch-action:pan-y}.is-touring .viewer-bottom{padding-top:2px}.tour-return{white-space:nowrap}

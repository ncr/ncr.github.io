---
// The p(bloom) post: the music video on top, the article set in the video's type, the wallpaper gallery after it,
// a chapter rail in the left margin, sliders and copy buttons. /blog/omarchy-p-bloom-theme/ renders it.
import type { CollectionEntry } from 'astro:content'
import WallpaperGallery from './WallpaperGallery.astro'
import MusicVideo from './MusicVideo.astro'
import { render } from 'astro:content'
import { readingLabel } from '../reading'
// videoOnly: the film alone (the post's /video/ page, a link that plays in place where it is shared)
interface Props { post: CollectionEntry<'blog'>; videoOnly?: boolean }
const { post, videoOnly = false } = Astro.props
const { Content } = await render(post)
// the title as in the video: condensed caps, the last word set light in Pollen
const words = post.data.title.split(' '), last = words.pop()
const date = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
---
<article class="post pb">
  <header>
    {videoOnly ? (<>
      <p class="date">The p(bloom) music video</p>
      <h1>Prepare to <span class="accent">walk</span></h1>
    </>) : (<>
      <p class="date">{date} · {readingLabel(post.body)}</p>
      <h1>{words.join(' ')} <span class="accent">{last.toLowerCase()}</span></h1>
    </>)}
  </header>
  <MusicVideo />
  {videoOnly ? (
    <p class="discuss"><a href="/blog/omarchy-p-bloom-theme/">the post: 42 wallpapers for Omarchy, and how they were made</a></p>
  ) : (<>
    <div class="content"><Content /></div>
    <WallpaperGallery />
    {post.data.x && <p class="discuss"><a href={post.data.x}>comments on X</a></p>}
  </>)}
</article>


<style is:global>
  /* p(bloom) post typography: the video's voice — condensed caps (Archivo Narrow), the name and accents in light
     Jost as in the video, reading text in Figtree (geometric like Jost, more open), the site's mono for small labels. Scoped to .pb so the rest of the site is untouched. */
  @font-face { font-family: 'Archivo Narrow'; font-weight: 600 700; font-display: swap; src: url('/fonts/archivo-narrow-700.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
  @font-face { font-family: 'Archivo Narrow'; font-weight: 600 700; font-display: swap; src: url('/fonts/archivo-narrow-700-ext.woff2') format('woff2'); unicode-range: U+0100-024F, U+1E00-1EFF, U+2020, U+20A0-20AB, U+20AD-20CF, U+2C60-2C7F, U+A720-A7FF; }
  @font-face { font-family: 'Jost'; font-weight: 300 500; font-display: swap; src: url('/fonts/jost-400.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
  @font-face { font-family: 'Jost'; font-weight: 300 500; font-display: swap; src: url('/fonts/jost-400-ext.woff2') format('woff2'); unicode-range: U+0100-024F, U+1E00-1EFF, U+2020, U+20A0-20AB, U+20AD-20CF, U+2C60-2C7F, U+A720-A7FF; }
  @font-face { font-family: 'Figtree'; font-style: italic; font-weight: 300 700; font-display: swap; src: url('/fonts/figtree-italic-var-ext.woff2') format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }
  @font-face { font-family: 'Figtree'; font-style: italic; font-weight: 300 700; font-display: swap; src: url('/fonts/figtree-italic-var.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
  @font-face { font-family: 'Figtree'; font-style: normal; font-weight: 300 700; font-display: swap; src: url('/fonts/figtree-var-ext.woff2') format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF; }
  @font-face { font-family: 'Figtree'; font-style: normal; font-weight: 300 700; font-display: swap; src: url('/fonts/figtree-var.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
  @font-face { font-family: 'Jost'; font-style: italic; font-weight: 400; font-display: swap; src: url('/fonts/jost-400-italic.woff2') format('woff2'); }
  /* Layout. The reading column holds about 70 characters at every size: the type grows with the window (17 px on a
     phone, 22 px on a large screen) and the column, set in ems, grows with it. The film, the wide comparisons and the
     gallery break out of the column to --pb-wide; on wide screens a chapter rail sits in the left margin. */
  :root { --pb-size: clamp(1.0625rem, .97rem + .27vw, 1.375rem); --pb-text: calc(var(--pb-size) * 33); --pb-wide: 1240px; }
  .page:has(.pb) { max-width: none; container-type: inline-size; }
  .page:has(.pb) > .masthead, .page:has(.pb) > .footer, .pb { max-width: var(--pb-text); margin-inline: auto; }
  .pb { --breakout: min(var(--pb-wide), 100cqw); }
  article.pb .breakout, article.pb .content > .wide, article.pb .wallpaper-entry { width: var(--breakout); max-width: none; margin-left: calc((100% - var(--breakout)) / 2); }
  .pb { --pollen: #f5c945; --signal: #4cc9ff; --narrow: 'Archivo Narrow', 'Arial Narrow', sans-serif; --read: 'Figtree', system-ui, sans-serif; --brand: 'Jost', system-ui, sans-serif;
        --text: color-mix(in srgb, var(--fg) 90%, var(--bg)); --caption: color-mix(in srgb, var(--fg) 62%, var(--bg));
        font-family: var(--read); font-size: var(--pb-size); line-height: 1.6; font-weight: 400; font-kerning: normal; }
  .pb .content p, .pb .content li { color: var(--text); text-wrap: pretty; hanging-punctuation: first; }
  :root[data-theme="classic"] .pb { --pollen: #b8860b; }
  .pb header { margin-bottom: 2.6rem; }
  .pb header .date { font-family: var(--mono); font-size: .75rem; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
  .pb h1 { font-family: var(--narrow); font-weight: 700; text-transform: uppercase; font-size: clamp(3rem, 10vw, 3.4em); line-height: .9; letter-spacing: -.012em; margin: .6rem 0 0; text-wrap: balance; }
  .pb h1 .accent { font-family: var(--brand); font-weight: 300; text-transform: none; letter-spacing: -.01em; color: var(--pollen); }
  .pb .content { counter-reset: sec; }
  .pb .content p { margin: 0 0 1.15em; }
  .pb .content a { color: var(--link); text-decoration-color: var(--underline); text-underline-offset: .18em; }
  /* the table of contents: three chapter cards, set like the chapter openings (numeral in Pollen, title in caps) */
  .pb .content > ol:first-child { list-style: none; counter-reset: toc; padding: 0; margin: 0 0 2.6rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .pb .content > ol:first-child li { counter-increment: toc; margin: 0; }
  .pb .content > ol:first-child a { display: block; height: 100%; padding: .9rem 1rem 1rem; border: 1px solid var(--hairline); border-radius: 10px; text-decoration: none; color: var(--fg); font-family: var(--narrow); font-weight: 700; text-transform: uppercase; font-size: 1.15em; line-height: 1; letter-spacing: .005em; transition: border-color .15s ease, background .15s ease; }
  .pb .content > ol:first-child a::before { content: counter(toc, decimal-leading-zero); display: block; font-size: 2.2rem; line-height: .9; color: var(--pollen); margin-bottom: .45rem; }
  .pb .content > ol:first-child a:hover { border-color: var(--link); background: color-mix(in srgb, var(--link) 7%, transparent); }
  @media (max-width: 600px) { .pb .content > ol:first-child { grid-template-columns: 1fr; } .pb .content > ol:first-child a { display: flex; align-items: baseline; gap: .8rem; } .pb .content > ol:first-child a::before { margin: 0; font-size: 1.6rem; } }
  /* chapters: a big numeral, then the title in condensed caps */
  .pb .content h2 { counter-increment: sec; font-family: var(--narrow); font-weight: 700; text-transform: uppercase; font-size: 2.35em; line-height: .95; letter-spacing: -.005em; margin: 4.4rem 0 1.5rem; padding-top: 1.4rem; border-top: 1px solid var(--hairline); }
  .pb .content h2::before { content: counter(sec, decimal-leading-zero); display: block; font-size: 1.6em; line-height: .9; color: var(--pollen); margin-bottom: .35rem; }
  /* lead-ins of the feature paragraphs and list items, set like the video's captions */
  .pb .content p > strong:first-child, .pb .content li > strong:first-child { font-family: var(--narrow); font-weight: 700; text-transform: uppercase; letter-spacing: .015em; font-size: 1.08em; }
  .pb .content ul { list-style: none; padding: 0; margin: 1.4rem 0 1.6rem; border-top: 1px solid var(--hairline); }
  .pb .content ul li { margin: 0; padding: .6rem 0; border-bottom: 1px solid var(--hairline); }
  .pb .content blockquote { font-style: italic; }
  .pb pre { position: relative; font-family: var(--mono); font-size: .7em; line-height: 1.55; border-radius: 10px; border: 1px solid var(--hairline); padding: 1em 1.15em; margin: 1.2rem 0 2rem; overflow-x: auto; }
  .pb pre.has-copy { padding-top: 2.9em; }
  .pb pre.has-copy::before { content: "Terminal"; position: absolute; left: 1.15em; top: .95em; font-size: .78em; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .pb .copy { position: absolute; top: .55em; right: .55em; font-family: var(--mono); font-size: .65rem; letter-spacing: .12em; text-transform: uppercase; color: var(--fg); background: var(--bg); border: 1px solid var(--hairline); border-radius: 6px; padding: 5px 9px; cursor: pointer; }
  .pb .copy:hover { border-color: var(--link); color: var(--link); } .pb .copy.done { color: var(--pollen); border-color: var(--pollen); }
    /* captions read as sentences: the reading face, a step smaller, in a quieter but legible tone */
  .pb figcaption { font-family: var(--read); font-size: .8em !important; line-height: 1.45; letter-spacing: 0; text-transform: none; color: var(--caption) !important; margin-top: .7em !important; text-wrap: pretty; }
  .pb .compare-title { margin: 0 0 .6em; font-family: var(--narrow); font-weight: 700; font-size: .95em; letter-spacing: .02em; text-transform: uppercase; color: var(--fg); }
  .pb .compare-title strong { font-weight: 700; color: inherit; }
  .pb .destiny-palette span { font-family: var(--mono); font-size: .62em; letter-spacing: .08em; text-transform: uppercase; }
  /* the answer to the post's question gets the strongest type, the sign-off the lightest */
  .pb .content .closer { font-family: var(--narrow); font-weight: 700; text-transform: uppercase; font-size: clamp(1.9rem, 5vw, 2.7rem); line-height: 1; margin: 2.8rem 0 1.4rem; text-wrap: balance; }
  .pb .content .closer em { font-family: var(--brand); font-weight: 300; font-style: normal; text-transform: none; color: var(--pollen); }
  .pb .content .signoff { font-family: var(--brand); font-weight: 300; font-size: 1.5rem; color: var(--muted); margin: 0 0 1rem; }
  .pb .content > ol:first-child + h2 { border-top: 0; padding-top: 0; margin-top: 3rem; }
  .pb .gallery-invite strong { font-family: var(--narrow); font-weight: 700; text-transform: uppercase; letter-spacing: .01em; font-size: 1.7rem; line-height: 1; }
  .pb .gallery-invite small { font-family: var(--mono); font-size: .68rem; letter-spacing: .14em; text-transform: uppercase; }
  /* lead-ins pop in Signal; the name is set as in the video: light, in Pollen, never in caps */
  .pb { --lead: #4cc9ff; } :root[data-theme="classic"] .pb { --lead: #0a6fa8; }
  .pb .content p > strong:first-child, .pb .content li > strong:first-child { color: var(--lead); }
  .pb .pbn { font-family: var(--brand); font-weight: 300; text-transform: none; letter-spacing: 0; color: var(--pollen); }
  .pb strong .pbn { font-weight: 400; }
  .pb .pdn { color: var(--muted); }
  @media (max-width: 600px) { .pb .content h2 { font-size: 2.1em; margin-top: 3.6rem; } }

  /* the chapter rail: in the left margin once the inline contents have scrolled away; only where the margin fits it */
  .pb-rail { position: fixed; z-index: 20; top: 50%; width: 11.5rem; left: calc((100vw - var(--pb-text)) / 2 - 14.5rem); transform: translate(-6px, -50%); opacity: 0; visibility: hidden; transition: opacity .3s ease, transform .3s ease, visibility 0s .3s; }
  .pb-rail.is-on { opacity: 1; visibility: visible; transform: translate(0, -50%); transition: opacity .3s ease, transform .3s ease; }
  .pb-rail ol { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--hairline); }
  .pb-rail a { position: relative; display: grid; grid-template-columns: 2.1rem 1fr; align-items: baseline; padding: .5rem 0 .5rem 1rem; font-family: var(--narrow); font-weight: 700; text-transform: uppercase; font-size: .95rem; line-height: 1.1; letter-spacing: .02em; color: var(--muted); text-decoration: none; transition: color .2s ease; }
  .pb-rail a b { font-size: 1.2rem; font-weight: 700; transition: color .2s ease; }
  .pb-rail a::before { content: ""; position: absolute; left: -1px; top: .45rem; bottom: .45rem; width: 2px; background: var(--pollen); transform: scaleY(0); transition: transform .25s ease; }
  .pb-rail a:hover, .pb-rail a:focus-visible { color: var(--fg); outline: none; }
  .pb-rail a[aria-current="true"] { color: var(--fg); }
  .pb-rail a[aria-current="true"] b { color: var(--pollen); }
  .pb-rail a[aria-current="true"]::before { transform: none; }
  @media (prefers-reduced-motion: reduce) { .pb-rail, .pb-rail.is-on, .pb-rail a::before { transition: none; } }

  .destiny-palette { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin:24px 0; }
  .destiny-palette small { display:block; color:var(--muted); font-size:.92em; letter-spacing:.04em; }
  .inside-figure { margin:1.6rem 0 2.2rem; }
  /* the app as Omarchy's menu shows it: its icon and its name */
  .pb .app-launch { display:inline-flex; align-items:center; gap:16px; margin:.2rem 0 2.2rem; padding:10px 22px 10px 10px; border:1px solid var(--hairline); border-radius:14px; }
  .pb .app-launch img { width:64px; height:64px; display:block; }
  .pb kbd { font-family:var(--mono); font-size:.72em; letter-spacing:.06em; border:1px solid var(--hairline); border-bottom-width:2px; border-radius:6px; padding:.1em .5em; white-space:nowrap; }
  .inside-figure img { width:100%; height:auto; display:block; border-radius:10px; border:1px solid var(--hairline); }
  
  .destiny-palette span { border-top:12px solid var(--swatch); padding-top:8px; }
  .destiny-monitor { width:min(1240px,calc(100vw - 40px)); position:relative; left:50%; transform:translateX(-50%); margin:32px 0; }
  .destiny-monitor img { width:100%; height:auto; border-radius:8px; }
  .destiny-monitor figcaption { max-width:42rem; margin:12px auto; }
  @media(max-width:600px) { .destiny-palette {grid-template-columns:repeat(2,1fr);} }

  .detail-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; width: min(1240px, calc(100vw - 40px)); position: relative; left: 50%; transform: translateX(-50%); margin: 2rem 0; }
  .detail-pair .figure { margin: 0; min-width: 0; }
  .detail-pair .figure > p { margin: 0 0 12px; }
  .detail-pair img { width: 100%; }
  .detail-triptych { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 800px) { .detail-pair { grid-template-columns: 1fr; width: 100%; gap: 28px; } }
  .compare-figure { margin: 2.2rem 0 2.4rem; }
  .compare-title { margin: 0 0 12px; }
  .compare { position: relative; width: 100%; overflow: hidden; border-radius: 10px; border: 1px solid var(--hairline); user-select: none; touch-action: pan-y; background: #090d16; }
  .compare img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; object-fit: cover; margin: 0; max-width: none; }
  .compare-before { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .compare-handle { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: #fff; box-shadow: 0 0 10px #0009; pointer-events: none; }
  .compare-handle::after { content: "‹ ›"; position: absolute; top: 50%; left: 50%; width: 44px; height: 44px; margin: -22px 0 0 -22px; display: grid; place-items: center; border-radius: 50%; background: #070a11d9; border: 1.5px solid #fff; color: #fff; font: 600 16px/1 system-ui, sans-serif; letter-spacing: 2px; }
  .compare-label { position: absolute; top: 12px; padding: 5px 10px; border-radius: 6px; background: #070a11cc; color: #e8f0ff; font: 500 13px/1.3 var(--read); pointer-events: none; }
  .compare-label-left { left: 12px; } .compare-label-right { right: 12px; }
  .compare-bottom .compare-label { top: auto; bottom: 10px; }
  .compare-range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; -webkit-appearance: none; appearance: none; }
  .compare-range:focus-visible + .compare-handle, .compare:has(.compare-range:focus-visible) .compare-handle::after { outline: 2px solid var(--link); outline-offset: 3px; }
  
  @media (max-width: 800px) { .compare-label { font-size: 11px; top: 8px; } .compare-label-left { left: 8px; } .compare-label-right { right: 8px; } }
</style>
<script>
  // "p(bloom)" set as in the video (light, Pollen), "p(doom)" faded; code blocks are left alone
  { const w = document.createTreeWalker(document.querySelector('.pb .content'), NodeFilter.SHOW_TEXT, { acceptNode: n => n.parentElement.closest('pre, code, a, .pbn, .pdn') ? NodeFilter.FILTER_REJECT : /p\((bloom|doom)\)/.test(n.data) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_SKIP });
    const nodes = []; while (w.nextNode()) nodes.push(w.currentNode);
    for (const n of nodes) { const f = document.createDocumentFragment(); n.data.split(/(p\((?:bloom|doom)\))/).forEach(part => { if (/^p\((bloom|doom)\)$/.test(part)) { const e = document.createElement('span'); e.className = part === 'p(bloom)' ? 'pbn' : 'pdn'; e.textContent = part; f.append(e); } else if (part) f.append(part); }); n.replaceWith(f); } }
  // the chapter rail, built from the inline contents: shown in the left margin once those have scrolled away
  { const toc = document.querySelector('.pb .content > ol:first-child'), heads = [...document.querySelectorAll('.pb .content h2[id]')];
    if (toc && heads.length) {
      const rail = document.createElement('nav'); rail.className = 'pb-rail'; rail.setAttribute('aria-label', 'Chapters');
      const ol = document.createElement('ol');
      heads.forEach((h, i) => { const li = document.createElement('li'), a = document.createElement('a'); a.href = `#${h.id}`; a.innerHTML = `<b>${String(i + 1).padStart(2, '0')}</b><span></span>`; a.lastChild.textContent = h.textContent; li.append(a); ol.append(li); });
      rail.append(ol); document.querySelector('.pb').append(rail);
      const links = [...rail.querySelectorAll('a')];
      let frame = 0;
      const update = () => {
        frame = 0;
        const past = toc.getBoundingClientRect().bottom < 0, text = document.querySelector('.pb').getBoundingClientRect(), fits = text.left >= rail.offsetWidth + 3 * 16 + 20;
        // anything that breaks out of the column into the margin (a wide figure, the gallery, the film) takes the
        // rail's place: the rail fades out while it passes and comes back after
        const r = rail.getBoundingClientRect(), wides = document.querySelectorAll('.pb .content > .wide, .pb .wallpaper-entry, .pb .mvi:not(.is-docked)');
        const covered = [...wides].some(el => { const b = el.getBoundingClientRect(); return b.left < r.right + 24 && b.top < r.bottom + 24 && b.bottom > r.top - 24; });
        rail.classList.toggle('is-on', past && fits && !covered);
        rail.style.left = `${text.left - rail.offsetWidth - 3 * 16}px`;
        let cur = -1; heads.forEach((h, i) => { if (h.getBoundingClientRect().top < innerHeight * .4) cur = i; });
        links.forEach((a, i) => a.setAttribute('aria-current', String(i === cur)));
      };
      addEventListener('scroll', () => { frame ||= requestAnimationFrame(update); }, { passive: true });
      addEventListener('resize', update); update();
    } }
  // a copy button on shell commands
  for (const pre of document.querySelectorAll('.pb pre')) {
    const code = pre.querySelector('code'); if (!code || !/bash|sh|shell/.test(pre.dataset.language || code.className)) continue;
    const b = document.createElement('button'); b.type = 'button'; b.className = 'copy'; b.textContent = 'Copy';
    b.addEventListener('click', async () => { try { await navigator.clipboard.writeText(code.innerText.trim()); b.textContent = 'Copied'; b.classList.add('done'); } catch { b.textContent = 'Select it'; } setTimeout(() => { b.textContent = 'Copy'; b.classList.remove('done'); }, 1600); });
    pre.appendChild(b); pre.classList.add('has-copy');
  }
  for (const c of document.querySelectorAll('.compare')) {
    const r = c.querySelector('.compare-range');
    const set = v => c.style.setProperty('--pos', v + '%');
    r.addEventListener('input', () => set(r.value));
    // dragging anywhere on the image moves the line, not only the (invisible) slider thumb
    c.addEventListener('pointerdown', e => {
      const move = ev => { const b = c.getBoundingClientRect(); const v = Math.max(0, Math.min(100, (ev.clientX - b.left) / b.width * 100)); r.value = v; set(v); };
      move(e); c.setPointerCapture(e.pointerId);
      const up = () => { c.removeEventListener('pointermove', move); c.removeEventListener('pointerup', up); c.removeEventListener('pointercancel', up); };
      c.addEventListener('pointermove', move); c.addEventListener('pointerup', up); c.addEventListener('pointercancel', up);
    });
  }
</script>

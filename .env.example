# skopiuj do .env (docker compose czyta .env automatycznie)
OWNER_PUBKEY=            # z: node peer/tools/keygen.mjs ~/.config/blog-owner.jwk.json
SITE_URL=http://localhost:8080
POW_BITS=18              # trudność dowodu pracy KOMENTARZA; głos/wizyta = POW_BITS-4.
                         # UWAGA: musi być identyczna u wszystkich (wchodzi w build strony)
ROOM_NS=ncr-blog         # przestrzeń nazw pokojów WebRTC – stała dla wszystkich kopii strony
SIGNALS=                 # CSV adresów signalingu wbudowany w stronę; puste = ten sam host co strona

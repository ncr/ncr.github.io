# skopiuj do .env (docker compose czyta .env automatycznie)
OWNER_PUBKEY=            # z: node peer/tools/keygen.mjs ~/.config/blog-owner.jwk.json
SITE_URL=http://localhost:8080
POW_BITS=18              # trudność dowodu pracy; 18 ≈ 0,6 s na desktopie, kilka s na telefonie
RATE_IP=5                # komentarzy z jednego IP w oknie
RATE_KEY=3               # komentarzy z jednej tożsamości w oknie
RATE_WINDOW_MIN=10
TRUST_PROXY=0            # 1 gdy przed kontenerem stoi reverse proxy (IP z X-Forwarded-For)
AKISMET_KEY=             # opcjonalnie; darmowy plan Personal dla blogów niekomercyjnych
